# Cloudflare Pages headers
# Content-hashed assets and self-hosted fonts are immutable — cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Universal links (app v1.7.5 referral): Apple fetches this file directly — JSON, no redirect.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# Referral link fallback (shown only when the app is not installed) — never indexed.
/r/*
  X-Robots-Tag: noindex
/friend-link/*
  X-Robots-Tag: noindex

# MCP connector OAuth consent (Supabase OAuth server, authorization path /oauth/consent).
# Never indexed, never framed (clickjacking on Allow), never cached, no referrer leak of the
# authorization_id to Apple / Google during sign-in.
/oauth/*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Cache-Control: no-store
  Referrer-Policy: no-referrer

# App v1.7.6 plan-writing skill: the plain-text files the athlete's own AI fetches. UTF-8 (the
# text uses × — ›), readable from any origin, short cache so a rulebook change reaches every AI.
/skills/design-program/SKILL.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
/skills/design-program/import-format.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
/skills/design-program/program-rules.v0.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
