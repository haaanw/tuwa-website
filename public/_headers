# Cloudflare Pages headers
# Content-hashed assets and self-hosted fonts are immutable — cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Universal links (app v1.7.5 referral): Apple fetches this file directly — JSON, no redirect.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# Referral link fallback (shown only when the app is not installed) — never indexed.
/r/*
  X-Robots-Tag: noindex
/friend-link/*
  X-Robots-Tag: noindex

# MCP connector OAuth consent (Supabase OAuth server, authorization path /oauth/consent).
# Never indexed, never framed (clickjacking on Allow), never cached, no referrer leak of the
# authorization_id to Apple / Google during sign-in.
/oauth/*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Cache-Control: no-store
  Referrer-Policy: no-referrer
