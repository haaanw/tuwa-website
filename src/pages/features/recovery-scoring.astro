---
// Recovery scoring — readiness against personal baselines (Pavilion rebuild).
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureFaq from '../../components/features/FeatureFaq.astro';
import FeatureClosing from '../../components/features/FeatureClosing.astro';
import { faqPageSchema } from '../../seo/schema';
import recoveryShot from '../../assets/screens-v16/recovery.png';

const title = 'Recovery Scoring: Readiness You Can Read';
const description =
  'Overnight HRV, sleep, and resting heart rate are scored against your own rolling baselines — not population norms — and compressed into one readiness number with plain-language reasons.';

const faqs = [
  {
    q: 'Which signals feed the score?',
    a: 'Tuwa reads the physiology you already collect through HealthKit — HRV, resting heart rate, and sleep — and pairs it with a morning wellness check-in where you rate soreness, energy, and stress. Every signal is compared to your own recent trend, not a population norm.',
  },
  {
    q: 'Why personal baselines instead of population norms?',
    a: 'HRV numbers vary enormously between athletes. An athlete with a resting HRV of 45 ms is not less recovered than one at 80 ms — the question is whether your HRV today sits above or below your own recent trend.',
  },
  {
    q: 'What if the numbers look fine but I feel wrecked?',
    a: 'The morning check-in is where your subjective read enters the model: you rate soreness, energy, and stress, and those answers can override the physiology when, for example, you feel wrecked despite clean numbers.',
  },
  {
    q: 'Does my raw health data leave my phone?',
    a: 'No. Tuwa reads HealthKit — it never writes to it — and raw health data never leaves the device. Only composite scores sync.',
  },
  {
    q: 'What does a low score actually change?',
    a: 'Physiology is one part of the verdict, not the verdict itself. The planned session, match proximity, soreness, and recent training history give the signal training context — and the output is a go, modify, or hold suggestion for the session you planned.',
  },
] as const;

const structuredData = [faqPageSchema(faqs)];
---
<BaseLayout
  title={title}
  description={description}
  ogImage="/og/recovery-scoring.png"
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="sec feat-hero">
    <div class="ghost num" data-ghost aria-hidden="true">82</div>
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>recovery</span>
        <h1 class="feat-h1" data-animate data-animate-delay="60">Readiness you can read</h1>
        <p class="feat-lead" data-animate data-animate-delay="120">
          Overnight HRV, sleep, and resting heart rate are scored against your own
          rolling baselines — not population norms — and compressed into one number
          with plain-language reasons. You don't get a dashboard to interpret. You
          get a score and the why.
        </p>
      </div>
    </div>
  </section>

  <!-- How it works — personal baselines -->
  <section class="sec sec-alt bt">
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>how it works</span>
        <h2 data-animate>Your baseline, not the crowd's</h2>
        <p data-animate>
          Each morning, Tuwa pulls overnight physiological data from Apple HealthKit
          and combines it with a short wellness check-in to produce a single
          readiness number between 0 and 100. The inputs are not treated equally,
          and none of them is judged against a population norm — every signal is
          compared to your own recent trend.
        </p>
        <p data-animate data-animate-delay="80">
          HRV numbers vary enormously between athletes. What matters is whether your
          signals are above or below your own recent trend, and how that trend
          intersects with today's planned lift.
        </p>
      </div>
      <div class="sec-body">
        <div class="spread" data-spread>
          <div class="plate" data-fan="c"><Image src={recoveryShot} alt="Tuwa recovery screen: HRV and sleep trends against personal baselines" width={640} format="webp" loading="lazy" decoding="async" /></div>
        </div>
        <div class="aside quote" data-animate data-quote>
          <div class="quote-rule"></div>
          <blockquote>
            A score of 62 is never just a number: your HRV is tracking 8% below your
            recent baseline, your sleep ran short, but your resting heart rate is
            normal.
          </blockquote>
          <p style="margin-top:16px">You see the reasoning, not just the verdict.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The honest blend -->
  <section class="sec bt">
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>the honest blend</span>
        <h2 data-animate>Physiology, blended with how you feel</h2>
        <p data-animate>
          The morning wellness check-in — where you rate soreness, energy, and
          stress — adds the context no wearable can measure. Those answers can
          override the physiology when, for example, you feel wrecked despite clean
          numbers.
        </p>
        <p data-animate data-animate-delay="80">
          HRV is also noisy. A poor night's sleep, a late game, or an unusually
          early alarm can affect a single measurement — which is exactly why Tuwa
          tracks trends rather than reacting to individual data points. Physiology
          is one part of the verdict, not the verdict itself.
        </p>
      </div>
    </div>
  </section>

  <!-- The science behind it -->
  <section class="sec sec-alt bt">
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>the science</span>
        <h2 data-animate>Why HRV carries the most weight</h2>
        <p data-animate>
          Heart rate variability is the variation in time between consecutive
          heartbeats, measured in milliseconds. A perfectly metronomic heartbeat —
          every interval exactly the same — is actually a sign of stress. Healthy
          hearts show subtle beat-to-beat variation because they're responding to
          signals from the autonomic nervous system, which balances the sympathetic
          (fight-or-flight) and parasympathetic (rest-and-digest) branches.
        </p>
        <p data-animate data-animate-delay="80">
          When you're well-recovered, parasympathetic activity is dominant and HRV
          is higher. When you're stressed, fatigued, or fighting off illness,
          sympathetic tone increases and HRV drops. This is why HRV has become one
          of the most researched biomarkers in sports science over the past two
          decades — it's a window into your nervous system's current state.
        </p>
      </div>
    </div>
  </section>

  <FeatureFaq heading="Common questions" faqs={faqs} />

  <FeatureClosing
    heading="A score and the why"
    body="Download Tuwa to bring your own plan, check today's verdict, and adjust the top set before you train."
    ctaNote="iOS 17+ · iPhone"
    related={[
      { label: 'The daily verdict', href: '/features/verdict' },
      { label: 'Workload tracking', href: '/features/workload-tracking' },
      { label: 'Starting out', href: '/features/cold-start' },
      { label: 'Readiness score explained', href: '/readiness-score' },
      { label: 'Methodology', href: '/methodology' },
    ]}
  />

  <script>
    import '../../scripts/featureMotion.ts';
  </script>
</BaseLayout>
