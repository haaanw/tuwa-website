---
// The OAuth consent page for the Tuwa MCP connector. Supabase's OAuth 2.1 server sends the
// athlete here (authorization path /oauth/consent) when they add Tuwa to Claude or ChatGPT.
// One route for every language: the script picks en or zh from the browser. All states are
// in the markup and hidden; src/scripts/oauthConsent.ts shows one at a time and fills the text.
// Never indexed (robots meta here, X-Robots-Tag in _headers, the sitemap filter).
import '@fontsource/noto-sans-sc/400.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CJKFonts from '../../components/CJKFonts.astro';
import t from '../../i18n/locales/en/oauth-consent';
---
<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  canonical="https://tuwa.app/oauth/consent/"
  hreflangAlternates={[]}
  locale="en"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
  </Fragment>
  <CJKFonts />

  <div class="consent-page">
    <div class="consent-column" data-oauth-consent aria-busy="true" aria-live="polite">

      <!-- loading -->
      <section data-state="loading" class="consent-plate">
        <p class="consent-quiet" data-t="loading">{t.loading}</p>
        <noscript><p class="consent-quiet">Turn on JavaScript to continue.</p></noscript>
      </section>

      <!-- error -->
      <section data-state="error" class="consent-plate" hidden>
        <p class="consent-body" data-el="error-message"></p>
      </section>

      <!-- sign in -->
      <section data-state="signin" class="consent-plate" hidden>
        <h1 class="consent-heading" data-t="signIn.heading">{t.signIn.heading}</h1>
        <p class="consent-body" data-t="signIn.lede">{t.signIn.lede}</p>

        <div class="consent-providers">
          <button type="button" class="consent-provider consent-provider--apple" data-el="apple-button">
            <svg aria-hidden="true" viewBox="0 0 384 512" width="16" height="18"><path fill="currentColor" d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>
            <span data-t="signIn.apple">{t.signIn.apple}</span>
          </button>
          <button type="button" class="consent-provider consent-provider--google" data-el="google-button">
            <svg aria-hidden="true" viewBox="0 0 48 48" width="18" height="18"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
            <span data-t="signIn.google">{t.signIn.google}</span>
          </button>
        </div>

        <div class="consent-or" aria-hidden="true"><span class="micro" data-t="signIn.or">{t.signIn.or}</span></div>

        <!-- Email + password (existing accounts only, as in the app), or a one-time code. -->
        <form class="consent-form" data-el="email-form" novalidate>
          <label class="consent-label" for="consent-email" data-t="signIn.emailLabel">{t.signIn.emailLabel}</label>
          <input id="consent-email" class="consent-input" data-el="email-input" type="email" autocomplete="username" inputmode="email" required />
          <p class="consent-hint" data-t="signIn.emailHint">{t.signIn.emailHint}</p>
          <label class="consent-label" for="consent-password" data-t="signIn.passwordLabel">{t.signIn.passwordLabel}</label>
          <input id="consent-password" class="consent-input" data-el="password-input" type="password" autocomplete="current-password" />
          <p class="consent-hint" data-t="signIn.passwordHint">{t.signIn.passwordHint}</p>
          <div class="consent-form-row">
            <button type="submit" class="consent-quiet-button" data-t="signIn.passwordSubmit">{t.signIn.passwordSubmit}</button>
            <button type="button" class="consent-link" data-el="send-code" data-t="signIn.sendCode">{t.signIn.sendCode}</button>
          </div>
          <button type="button" class="consent-link" data-el="forgot-password" data-t="signIn.forgotPassword">{t.signIn.forgotPassword}</button>
        </form>

        <!-- Forgot password (ruling A1): a 6-digit code + a new password, as in the app. -->
        <form class="consent-form" data-el="reset-form" novalidate hidden>
          <p class="consent-body" data-el="reset-sent"></p>
          <label class="consent-label" for="consent-reset-code" data-t="signIn.codeLabel">{t.signIn.codeLabel}</label>
          <input id="consent-reset-code" class="consent-input consent-input--code" data-el="reset-code-input" type="text" autocomplete="one-time-code" inputmode="numeric" maxlength="10" required />
          <label class="consent-label" for="consent-new-password" data-t="signIn.newPasswordLabel">{t.signIn.newPasswordLabel}</label>
          <input id="consent-new-password" class="consent-input" data-el="new-password-input" type="password" autocomplete="new-password" minlength="8" required />
          <p class="consent-hint" data-t="signIn.newPasswordHint">{t.signIn.newPasswordHint}</p>
          <div class="consent-form-row">
            <button type="submit" class="consent-quiet-button" data-t="signIn.resetSubmit">{t.signIn.resetSubmit}</button>
            <button type="button" class="consent-link" data-el="reset-resend" data-t="signIn.resetResend">{t.signIn.resetResend}</button>
          </div>
          <button type="button" class="consent-link" data-el="reset-back" data-t="signIn.otherEmail">{t.signIn.otherEmail}</button>
        </form>

        <form class="consent-form" data-el="code-form" novalidate hidden>
          <p class="consent-body" data-el="code-sent"></p>
          <label class="consent-label" for="consent-code" data-t="signIn.codeLabel">{t.signIn.codeLabel}</label>
          <input id="consent-code" class="consent-input consent-input--code" data-el="code-input" type="text" autocomplete="one-time-code" inputmode="numeric" maxlength="10" required />
          <p class="consent-hint" data-t="signIn.linkNote">{t.signIn.linkNote}</p>
          <div class="consent-form-row">
            <button type="submit" class="consent-quiet-button" data-t="signIn.verify">{t.signIn.verify}</button>
            <button type="button" class="consent-link" data-el="other-email" data-t="signIn.otherEmail">{t.signIn.otherEmail}</button>
          </div>
        </form>

        <p class="consent-note" data-el="signin-note" role="alert" hidden></p>
      </section>

      <!-- consent -->
      <section data-state="consent" class="consent-plate" hidden>
        <h1 class="consent-heading" data-el="consent-heading"></h1>
        <p class="consent-quiet" data-el="consent-return"></p>

        <dl class="consent-rows">
          <div class="consent-row">
            <dt class="micro" data-t="consent.readsKey">{t.consent.readsKey}</dt>
            <dd data-t="consent.reads">{t.consent.reads}</dd>
          </div>
          <div class="consent-row">
            <dt class="micro" data-t="consent.sendsKey">{t.consent.sendsKey}</dt>
            <dd data-t="consent.sends">{t.consent.sends}</dd>
          </div>
          <div class="consent-row">
            <dt class="micro" data-t="consent.cannotKey">{t.consent.cannotKey}</dt>
            <dd data-t="consent.cannot">{t.consent.cannot}</dd>
          </div>
          <div class="consent-row">
            <dt class="micro" data-t="consent.neverKey">{t.consent.neverKey}</dt>
            <dd data-t="consent.never">{t.consent.never}</dd>
          </div>
          <div class="consent-row" data-el="account-row" hidden>
            <dt class="micro" data-t="consent.accountKey">{t.consent.accountKey}</dt>
            <dd data-el="account-value"></dd>
          </div>
          <div class="consent-row">
            <dt class="micro" data-t="consent.providerKey">{t.consent.providerKey}</dt>
            <dd data-t="consent.provider">{t.consent.provider}</dd>
          </div>
          <div class="consent-row">
            <dt class="micro" data-t="consent.keptKey">{t.consent.keptKey}</dt>
            <dd data-t="consent.kept">{t.consent.kept}</dd>
          </div>
        </dl>

        <p class="consent-hint" data-t="consent.inApp">{t.consent.inApp}</p>
        <p class="consent-hint" data-t="consent.revoke">{t.consent.revoke}</p>

        <div class="consent-decision" role="group">
          <button type="button" class="consent-cell" data-el="deny-button" data-t="consent.deny">{t.consent.deny}</button>
          <button type="button" class="consent-cell" data-el="allow-button" data-t="consent.allow">{t.consent.allow}</button>
        </div>

        <p class="consent-quiet consent-account">
          <span data-el="signed-in-as"></span>
          <button type="button" class="consent-link" data-el="sign-out" data-t="consent.signOut">{t.consent.signOut}</button>
        </p>
      </section>

      <!-- done -->
      <section data-state="done" class="consent-plate" hidden>
        <p class="consent-body" data-el="done-message"></p>
        <p><a class="consent-link" data-el="done-link" href="#" data-t="done.manual">{t.done.manual}</a></p>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/oauthConsent.ts';
</script>

<style>
  .consent-page {
    padding: var(--space-3xl) var(--space-md);
  }
  .consent-column {
    max-width: 480px;
    margin: 0 auto;
  }
  .consent-plate {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--color-surface-el);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
  }
  .consent-plate[hidden],
  .consent-form[hidden],
  .consent-row[hidden],
  .consent-note[hidden] {
    display: none;
  }
  .consent-heading {
    font-size: 24px;
    font-weight: var(--weight-medium);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text-1);
    overflow-wrap: anywhere;
  }
  .consent-body {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text-1);
  }
  .consent-quiet {
    font-size: var(--text-label);
    line-height: var(--leading-label);
    color: var(--color-text-2);
    overflow-wrap: anywhere;
  }
  .consent-hint {
    font-size: var(--text-small);
    line-height: var(--leading-label);
    color: var(--color-text-2);
  }
  .consent-providers {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  /* Apple and Google ask for their own button look (logo + "Continue with …"). */
  .consent-provider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    min-height: 48px;
    padding: 0 var(--space-md);
    border-radius: var(--radius-sm);
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    cursor: pointer;
  }
  .consent-provider--apple {
    background: #000000;
    color: #FFFFFF;
    border: 1px solid #000000;
  }
  .consent-provider--google {
    background: #FFFFFF;
    color: #1F1F1F;
    border: 1px solid #747775;
  }
  .consent-or {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .consent-or::before,
  .consent-or::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--color-divider);
  }
  .consent-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .consent-form-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }
  .consent-label {
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    color: var(--color-text-1);
  }
  .consent-input {
    min-height: 48px;
    padding: 0 var(--space-md);
    font-size: var(--text-body);
    color: var(--color-text-1);
    background: var(--color-surface-el-2);
    border: 1px solid var(--color-divider-strong);
    border-radius: var(--radius-sm);
  }
  .consent-input--code {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.2em;
  }
  .consent-input:focus-visible,
  .consent-provider:focus-visible,
  .consent-quiet-button:focus-visible,
  .consent-cell:focus-visible,
  .consent-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .consent-quiet-button {
    align-self: flex-start;
    min-height: 44px;
    padding: 0 var(--space-lg);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    color: var(--color-text-1);
    background: transparent;
    border: 1px solid var(--color-divider-strong);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
  .consent-link {
    padding: 0;
    font-size: var(--text-label);
    color: var(--color-text-2);
    text-decoration: underline;
    background: none;
    border: none;
    cursor: pointer;
  }
  .consent-note {
    font-size: var(--text-label);
    line-height: var(--leading-label);
    color: var(--color-zone-danger);
  }
  .consent-rows {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-divider);
  }
  .consent-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .consent-row dd {
    font-size: var(--text-label);
    line-height: var(--leading-body);
    color: var(--color-text-1);
    overflow-wrap: anywhere;
  }
  /* Allow and Deny are equal-weight butted cells: the page never leans on the athlete. */
  .consent-decision {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--color-divider-strong);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .consent-cell {
    min-height: 52px;
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    color: var(--color-text-1);
    background: var(--color-surface-el-2);
    border: none;
    cursor: pointer;
  }
  .consent-cell + .consent-cell {
    border-left: 1px solid var(--color-divider-strong);
  }
  .consent-cell:hover:not(:disabled),
  .consent-quiet-button:hover:not(:disabled) {
    background: var(--color-surface);
  }
  button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .consent-account {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: baseline;
  }
</style>
