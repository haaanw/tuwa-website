---
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/700.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SeriesIndex from '../../../components/blog/SeriesIndex.astro';
import { useBlogTranslations } from '../../../i18n/utils';

const t = useBlogTranslations('zh');
---

<style is:global>
  html[lang="zh"] { --font-general-sans: 'General Sans', 'Noto Sans SC', system-ui, sans-serif; }
</style>

<BaseLayout title={t.meta.title} description={t.meta.description} locale="zh">
  <div class="section-spaced">
    <SeriesIndex locale="zh" />
  </div>
</BaseLayout>
