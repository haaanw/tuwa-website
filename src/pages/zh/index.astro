---
import { useTranslations } from '../../i18n/utils';
import CJKLayout from '../../layouts/CJKLayout.astro';
import Hero from '../../components/Hero.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import StatsCounter from '../../components/StatsCounter.astro';
import LandingCTA from '../../components/LandingCTA.astro';

import { softwareApplicationSchema, organizationSchema } from '../../seo/schema';

const t = useTranslations('zh');
const structuredData = [softwareApplicationSchema(t.meta.description), organizationSchema()];
---
<CJKLayout
  title="每一次训练都留在你的 strike zone"
  description={t.meta.description}
  structuredData={structuredData}
>
  <Hero locale="zh" />
  <FeatureGrid locale="zh" />
  <StatsCounter locale="zh" />
  <LandingCTA locale="zh" />
</CJKLayout>
