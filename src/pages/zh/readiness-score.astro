---
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/700.css';
import { useTopicTranslations } from '../../i18n/utils';
import TopicPageLayout from '../../layouts/TopicPageLayout.astro';

const content = useTopicTranslations('readiness-score', 'zh');
---

