---
// 训练负荷——一个疲劳预算（Pavilion 重建，zh）。结构与 EN 版逐节对应。
import { Image } from 'astro:assets';
import CJKLayout from '../../../layouts/CJKLayout.astro';
import FeatureFaq from '../../../components/features/FeatureFaq.astro';
import FeatureClosing from '../../../components/features/FeatureClosing.astro';
import { faqPageSchema } from '../../../seo/schema';
import workloadShot from '../../../assets/screens-v16/workload.png';
import dashboardShot from '../../../assets/screens-v16/dashboard.png';

const title = '训练负荷：一个疲劳预算';
const description =
  '专项技术、力量和体能消耗的是同一个油箱。Tuwa 把它们记成同一份负荷——急性对慢性——并把比值保持在 ACWR strike zone 内。';

const faqs = [
  {
    q: '哪些内容计入疲劳预算？',
    a: '你记录的每一次力量训练都包含动作、组数、次数、重量、RPE 和 RIR。篮球训练通过比赛等级记录获得自己的上下文，因此一次随意野球不会和一场正式比赛被看成同一种刺激。专项技术、力量和体能被记成同一份负荷。',
  },
  {
    q: 'ACWR strike zone 是什么？',
    a: '急性与慢性负荷比值把最近 7 天的负荷和最近 4 周做对比。Tuwa 的职责就是把它稳在 strike zone 里——大约 0.8 到 1.3。低于区间，说明你可能明显少于近期基础；高于区间，说明本周要求可能超过近期训练所支持的幅度。',
  },
  {
    q: '这个比值能预测伤病吗？',
    a: '不能。ACWR 框架描述的是人群层面的负荷关联，不是个体保证或预测；它辅助决定，而不是替你做决定。Tuwa 把目标区间当作计划上下文，而不是通用安全规则。',
  },
  {
    q: '为什么用移动平均而不是周总量？',
    a: 'Tuwa 使用指数加权移动平均计算负荷，让近期训练比更早训练权重更高。这样，在一周里有两场比赛和一次重下肢训练时，负荷模型会快速响应，而不是被旧数据固定住。',
  },
  {
    q: '负荷视图只是为了让我谨慎吗？',
    a: '不是。Tuwa 追踪个人纪录和训练历史，所以后方团队视角不只是谨慎。如果建议是 go，你可以带着整周背景认真训练；如果建议是 modify，你也知道自己保留了什么训练刺激。',
  },
] as const;

const structuredData = [faqPageSchema(faqs)];
---
<CJKLayout
  title={title}
  description={description}
  ogImage="/og/workload-tracking.png"
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="sec feat-hero">
    <div class="ghost num" data-ghost aria-hidden="true">1.3</div>
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>训练负荷</span>
        <h1 class="feat-h1" data-animate data-animate-delay="60">一个疲劳预算</h1>
        <p class="feat-lead" data-animate data-animate-delay="120">
          专项技术、力量、体能消耗的是同一个油箱。Tuwa 把它们记成同一份负荷——急性对慢性——并把比值保持在
          strike zone 内。当趋势指向超负荷，你会在身体有感觉之前几天就看到。
        </p>
      </div>
    </div>
  </section>

  <!-- How it works — the ledger + the needle -->
  <section class="sec sec-alt bt">
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>工作原理</span>
        <h2 data-animate>每一堂课都记进同一本账</h2>
        <p data-animate>
          你在 Tuwa 中记录的每一次力量训练，都会保留准备状态判定真正需要的细节：动作、组数、次数、重量、RPE 和
          RIR。篮球训练通过比赛等级记录，因此一次随意野球不会和一场正式比赛被看成同一种刺激。
        </p>
        <p data-animate data-animate-delay="80">
          Tuwa 使用指数加权移动平均，让近期训练比更早训练权重更高。这样，在一周里有两场比赛和一次重下肢训练时，负荷模型会快速响应，而不是被旧数据固定住。
        </p>
      </div>
      <div class="sec-body">
        <div class="spread" data-spread>
          <div class="plate" data-fan="l"><Image src={dashboardShot} alt="Tuwa 主界面：准备状态卡片显示 82 分与各项指标" width={640} format="webp" loading="lazy" decoding="async" /></div>
          <div class="plate" data-fan="c"><Image src={workloadShot} alt="Tuwa 训练负荷图表与 ACWR 趋势" width={640} format="webp" loading="lazy" decoding="async" /></div>
        </div>
        <div class="aside" data-animate>
          <div class="lottie-well"><div data-lottie="/lottie/needle-sweep.json" aria-label="动画：准备状态表盘，石灰华色指针扫过刻度弧线"></div></div>
          <span class="micro lottie-cap">测量出来的准备状态</span>
          <p style="margin-top:16px">
            指针由你自己的历史驱动，而不是人群平均值。同样的输入，同样的答案——引擎是确定性的。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The strike zone -->
  <section class="sec bt">
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>急性 : 慢性负荷比值</span>
        <h2 data-animate>Strike zone</h2>
        <p data-animate>
          这个比值把最近 7 天的负荷和最近 4 周做对比。Tuwa 的职责就是把它稳在 strike zone
          里。低于区间，说明你可能明显少于近期基础；高于区间，说明本周要求可能超过近期训练所支持的幅度。
        </p>
      </div>
      <div class="sec-body">
        <div class="aside" data-animate>
          <div class="privacy-well" style="margin-top:0">
            <ul>
              <li>低于 0.8——训练不足，还有加量空间</li>
              <li>0.8–1.3——正处在 strike zone</li>
              <li>1.3–1.5——注意，趋势偏热</li>
              <li>高于 1.5——危险，超负荷风险</li>
            </ul>
          </div>
          <p class="zone-foot" data-animate>
            区间名称永远写成文字——颜色只是辅助，从不是信息本身。
          </p>
        </div>
        <div class="aside" data-animate data-animate-delay="80">
          <p>
            Tuwa 把目标区间当作计划上下文，而不是通用安全规则。急慢性负荷的思路，是把近期负荷和更长周期的基线进行比较；它对产品最有用的启发不是用一个比值预测伤病，而是在你再加一次高强度力量训练前，先注意到负荷的突然变化。
          </p>
          <p style="margin-top:16px">
            一个疲劳预算覆盖专项技术、力量和体能——你还能看到它在未来几周的走向。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cross-modal context -->
  <section class="sec sec-alt bt">
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>跨项目疲劳</span>
        <h2 data-animate>昨晚的比赛，会影响今天的深蹲</h2>
        <p data-animate>
          一个全身可穿戴分数可以告诉你整体恢复或整体压力如何。但它说不出篮球运动员真正需要的那句话：昨晚比赛把腿打累了，今天深蹲准备状态下降，但卧推没问题。
        </p>
        <p data-animate data-animate-delay="80">
          Tuwa 能做出这种区分，是因为计划和日志在同一个系统里。场上训练、下肢酸痛、近期腿部训练量和计划深蹲顶组，会在判定出现前一起评估。
        </p>
      </div>
    </div>
  </section>

  <FeatureFaq heading="常见问题" faqs={faqs} />

  <FeatureClosing
    heading="留在你的 strike zone"
    body="下载 Tuwa，带入自己的计划，查看今天的建议，在训练前调整顶组。"
    ctaNote="iOS 17+ · iPhone"
    ctaLabel="在 App Store 下载"
    relatedAriaLabel="相关页面"
    related={[
      { label: '每日建议', href: '/zh/features/verdict' },
      { label: '恢复评分', href: '/zh/features/recovery-scoring' },
      { label: '记录与动作库', href: '/zh/features/smart-templates' },
      { label: '训练负荷指南', href: '/zh/training-load' },
      { label: '方法论', href: '/zh/methodology' },
    ]}
  />

  <!-- Self-hosted Lottie runtime (classic script: executes before the deferred
       featureMotion module below). No CDN URLs anywhere. -->
  <script is:inline src="/vendor/lottie.min.js"></script>
  <script>
    import '../../../scripts/featureMotion.ts';
  </script>
</CJKLayout>
