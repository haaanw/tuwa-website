---
// 冷启动——第一天就有用，但保持诚实（Pavilion 重建，zh）。结构与 EN 版逐节对应。
import { Image } from 'astro:assets';
import CJKLayout from '../../../layouts/CJKLayout.astro';
import FeatureFaq from '../../../components/features/FeatureFaq.astro';
import FeatureClosing from '../../../components/features/FeatureClosing.astro';
import { faqPageSchema } from '../../../seo/schema';
import workoutLogShot from '../../../assets/screens-v16/workout-log.png';

const title = '冷启动入门';
const description =
  '第一天就完成诚实的设置。Tuwa 用入门答案建立训练负荷档案，再等待真实恢复数据后做更明确的判断。';

const faqs = [
  {
    q: '需要先积累几周基线数据，Tuwa 才有用吗？',
    a: '不需要。Tuwa 第一天就有用：入门设置会建立你的训练档案，记录的训练立刻开始积累负荷历史。准备状态则更保守：当个人恢复历史还很少时，Tuwa 不会假装人群基线就是你的基线。',
  },
  {
    q: '第一天实际是什么样？',
    a: 'Tuwa 收集它可以诚实使用的背景：训练经历、计划训练节奏、身体状态自评，以及你授权的 HealthKit 数据。训练负荷追踪从第一次记录的训练开始构建。',
  },
  {
    q: '如果我几乎没有 HealthKit 历史怎么办？',
    a: '如果恢复历史很少，应用不会过度解读；没有数据时的恢复状态保持中性，而不是假装已经知道你的个人基线。',
  },
  {
    q: '早期判定会开始削减我的计划吗？',
    a: '当证据仍不足以支持有把握的调整时，判定可以选择暂缓，而不是凭猜测削减你的计划。',
  },
  {
    q: '为什么不干脆先显示一个恢复评分？',
    a: '虚假的精确度比承认不确定性更糟糕。如果一个应用在第一天没有任何生理数据的情况下就告诉你"你的恢复评分是 84 分"，那个数字是凭空捏造的——这种落差最终会彻底侵蚀对工具的信任。',
  },
] as const;

const structuredData = [faqPageSchema(faqs)];
---
<CJKLayout
  title={title}
  description={description}
  ogImage="/og/cold-start.png"
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="sec feat-hero">
    <div class="ghost num" data-ghost aria-hidden="true">01</div>
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>即刻开始</span>
        <h1 class="feat-h1" data-animate data-animate-delay="60">第一天就有用——但不假装确定</h1>
        <p class="feat-lead" data-animate data-animate-delay="120">
          Tuwa 从你的资料和第一批训练记录开始，随着真实数据进入而变得更个人化。恢复评分、训练负荷趋势和个人基线都会在真实记录出现后变得更好——Tuwa
          不会用虚假的精确度填补这个空白。
        </p>
      </div>
    </div>
  </section>

  <!-- How it works — three stages -->
  <section class="sec sec-alt bt">
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>工作原理</span>
        <h2 data-animate>从入门答案到你自己的基线</h2>
        <p data-animate>
          Tuwa 会先用入门问卷建立训练档案：运动背景、当前力量训练节奏、近期负荷，以及你准备记录的训练类型。这个档案让负荷模型从一开始就有结构；而准备状态和判定会在真实生理和训练数据足够前保持克制。
        </p>
      </div>
      <div class="sec-body">
        <div class="aside" data-animate>
          <h3 style="font-size:20px; font-weight:var(--weight-label); color:var(--color-text-1); margin-bottom:8px">第一天</h3>
          <p>
            Tuwa 收集它可以诚实使用的背景：训练经历、计划训练节奏、身体状态自评，以及你授权的 HealthKit
            数据。没有数据时的恢复状态保持中性，而不是假装已经知道你的个人基线。
          </p>
        </div>
        <div class="aside" data-animate data-animate-delay="80">
          <h3 style="font-size:20px; font-weight:var(--weight-label); color:var(--color-text-1); margin-bottom:8px">最初几次训练</h3>
          <p>
            当你开始记录训练，Tuwa 会从你实际完成的内容计算课次负荷：动作、组数、次数、重量、RPE 和
            RIR。这些记录会形成早期急性负荷视图。
          </p>
        </div>
        <div class="aside" data-animate data-animate-delay="160">
          <h3 style="font-size:20px; font-weight:var(--weight-label); color:var(--color-text-1); margin-bottom:8px">历史积累后</h3>
          <p>
            随着 HealthKit 读数、身体状态自评和训练记录稳定积累，Tuwa
            能把更多信号与你自己的近期趋势比较——解释也会越来越贴近你的生理状态和训练历史。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The first log -->
  <section class="sec bt">
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>从记录中生长</span>
        <h2 data-animate>第一堂训练就启动模型</h2>
        <p data-animate>
          训练负荷追踪会从第一次记录的训练开始构建。第一堂训练给 Tuwa
          一个真实负荷数据点，之后每一堂训练都会让急性和慢性负荷视图更有用。
        </p>
      </div>
      <div class="sec-body">
        <div class="spread" data-spread>
          <div class="plate" data-fan="c"><Image src={workoutLogShot} alt="Tuwa 训练日志：历史训练记录" width={640} format="webp" loading="lazy" decoding="async" /></div>
        </div>
        <div class="aside" data-animate>
          <p>
            认真对待训练的运动员通常已经对自身恢复状态有良好的直觉——这是多年训练、比赛和关注身体反应积累出来的。Tuwa
            的冷启动方案尊重这一点。早期它帮助你把记录结构化、说明哪些信息已知；当数据不完整时，仍给你的判断留下空间。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why honesty matters -->
  <section class="sec sec-alt bt">
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>原则</span>
        <h2 data-animate>为什么诚实很重要</h2>
        <p data-animate>
          虚假的精确度比承认不确定性更糟糕。如果一个应用在第一天没有任何生理数据的情况下就告诉你"你的恢复评分是
          84 分"，那个数字是凭空捏造的。依赖它训练的运动员，是在用虚构数据指导训练。
        </p>
        <p data-animate data-animate-delay="80">
          实际价值在这里：Tuwa 不在证据不足时装作自信，而是让你的真实记录逐步成为基线。随着 HealthKit
          读数、身体状态自评和训练记录增加，解释会越来越贴近你的生理状态和训练历史。
        </p>
      </div>
    </div>
  </section>

  <FeatureFaq heading="常见问题" faqs={faqs} />

  <FeatureClosing
    heading="让你的真实记录成为基线"
    body="下载 Tuwa，带入自己的计划，查看今天的建议，在训练前调整顶组。"
    ctaNote="iOS 17+ · iPhone"
    ctaLabel="在 App Store 下载"
    relatedAriaLabel="相关页面"
    related={[
      { label: '每日建议', href: '/zh/features/verdict' },
      { label: '恢复评分', href: '/zh/features/recovery-scoring' },
      { label: '训练负荷', href: '/zh/features/workload-tracking' },
      { label: '记录与动作库', href: '/zh/features/smart-templates' },
      { label: '方法论', href: '/zh/methodology' },
    ]}
  />

  <script>
    import '../../../scripts/featureMotion.ts';
  </script>
</CJKLayout>
