---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import StatsCounter from '../components/StatsCounter.astro';
import LandingCTA from '../components/LandingCTA.astro';
import { softwareApplicationSchema, organizationSchema } from '../seo/schema';

const description = "Precision training load and recovery management for serious athletes and coaches.";
const structuredData = [softwareApplicationSchema(description), organizationSchema()];
---
<BaseLayout
  title="Precision Training Load & Recovery for Serious Athletes"
  description={description}
  structuredData={structuredData}
>
  <Hero />
  <FeatureGrid />
  <StatsCounter />
  <LandingCTA />
</BaseLayout>
