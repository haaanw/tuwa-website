---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { countSources } from '../../components/blog/sources';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) =>
    !import.meta.env.PROD || !data.draft
  );
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const minutesRead = remarkPluginFrontmatter.minutesRead;

// Counted from the article's own reference list — see components/blog/sources.ts
// for why this is never a frontmatter field.
const sourceCount = countSources(post.body);
---
<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.coverImage ?? '/og-default.png'}
  date={post.data.date}
  updated={post.data.updated}
  slug={post.id}
  faq={post.data.faq}
  minutesRead={minutesRead}
  deck={post.data.deck}
  articleClass={post.data.articleClass}
  seriesNo={post.data.seriesNo}
  sourceCount={sourceCount}
>
  <Content />
</BlogPostLayout>
