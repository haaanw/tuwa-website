---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutPage from '../components/AboutPage.astro';
import { useAboutTranslations } from '../i18n/utils';
import { organizationSchema } from '../seo/schema';

const t = useAboutTranslations('en');
const structuredData = [organizationSchema()];
---
<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  structuredData={structuredData}
>
  <AboutPage />
</BaseLayout>
