---
import { useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import StatsCounter from '../../components/StatsCounter.astro';
import LandingCTA from '../../components/LandingCTA.astro';

import { softwareApplicationSchema, organizationSchema } from '../../seo/schema';

const t = useTranslations('fr');
const structuredData = [softwareApplicationSchema(t.meta.description), organizationSchema()];
---
<BaseLayout
  title="Entraînement de force adaptatif pour athlètes autonomes"
  description={t.meta.description}
  structuredData={structuredData}
  locale="fr"
>
  <Hero locale="fr" />
  <FeatureGrid locale="fr" />
  <StatsCounter locale="fr" />
  <LandingCTA locale="fr" />
</BaseLayout>
