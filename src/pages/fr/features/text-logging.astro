---
// Saisie de texte — tape la séance.
// Structure calquée section par section sur la version EN.
//
// v1.7.4 (décision de HAN, 2026-09-24) : LA SAISIE VOCALE DE LA SÉANCE A ÉTÉ
// RETIRÉE. Il n'y a plus de micro nulle part dans l'app désormais — ni dans
// le journal d'entraînement (séance guidée, saisie en liste, ou onglet
// Journal), ni dans l'importation d'un programme. L'athlète peut toujours
// taper une description, qui est analysée comme cette page l'a toujours
// décrit ; la saisie manuelle (réglette, sélecteur de répétitions, banque de
// mouvements) est inchangée. L'importation d'un programme (fonction séparée)
// se fait désormais en collant du texte ou en important un PDF/une photo, à
// la place de la voix. Le modèle de langue est un ANALYSEUR — il transforme
// du texte tapé en brouillon que l'athlète confirme. Ce n'est jamais un chat,
// un assistant ou un coach à qui on parle, et aucune phrase de cette page ne
// doit le laisser entendre.
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FeatureFaq from '../../../components/features/FeatureFaq.astro';
import FeatureClosing from '../../../components/features/FeatureClosing.astro';
import { faqPageSchema } from '../../../seo/schema';
import logCaptureShot from '../../../assets/screens-v16/log-capture.png';
import activeWorkoutShot from '../../../assets/screens-v16/active-workout.png';

const title = 'Saisie de texte : tape la séance';
const description =
  "Tape la séance comme tu la dirais à voix haute. Tuwa transforme la phrase en brouillon modifiable que tu confirmes — rien ne s'enregistre tout seul, la saisie manuelle ne disparaît jamais, et c'est gratuit sur toutes les formules.";

const faqs = [
  {
    q: "Qu'est-ce que je tape exactement ?",
    a: "Une phrase normale, comme à un partenaire d'entraînement : « squat, trois séries de cinq à 130, la dernière était lourde. Puis développé couché, quatre fois huit à quatre-vingts. » Tuwa y lit l'exercice, les séries, les répétitions et la charge, et remplit le brouillon. Aucune syntaxe à apprendre, aucune formulation à réussir.",
  },
  {
    q: 'La saisie vocale existe-t-elle encore ?',
    a: "Non. Depuis la v1.7.4, plus rien dans l'app n'utilise le micro — ni le journal d'entraînement, ni l'importation de programme. La saisie se fait au clavier ou en direct ; importer un programme se fait en collant du texte ou en important un PDF ou une photo.",
  },
  {
    q: "Peut-elle enregistrer une séance que je n'ai pas faite ?",
    a: "Non. L'analyse produit un brouillon dans l'écran de saisie habituel, toutes les séries posées. Rien n'entre dans ton journal avant ta confirmation, et chaque chiffre reste modifiable à la main jusque-là.",
  },
  {
    q: 'Est-ce que cela remplace la saisie manuelle ?',
    a: "Non, cela se place à côté. La réglette de charge, le sélecteur de répétitions, les modèles et la banque de mouvements sont inchangés — la saisie manuelle reste la façon de corriger quoi que ce soit, et reste la plus rapide pour une série entre deux tours.",
  },
  {
    q: 'Est-ce que ça marche en pleine séance, série par série ?',
    a: "Oui. Dans une séance en cours, tu peux taper une série dès que tu la termines, ou l'enregistrer directement sur la réglette : elle arrive dans l'exercice ouvert, sans masquer la liste des séries.",
  },
  {
    q: 'Où la phrase est-elle traitée ?',
    a: "Le texte que tu tapes part vers le service d'analyse de Tuwa et est traité par un modèle de langue tiers pour produire le brouillon. Les requêtes sont liées à ton compte connecté et plafonnées par un quota quotidien. Tes données HealthKit brutes — VFC, sommeil, fréquence cardiaque — n'y participent pas et ne quittent jamais ton téléphone.",
  },
  {
    q: 'Est-ce que cela coûte quelque chose ?',
    a: 'Non. La saisie de texte est gratuite sur toutes les formules, y compris la formule gratuite.',
  },
] as const;

const structuredData = [faqPageSchema(faqs)];
---
<BaseLayout title={title} description={description} structuredData={structuredData} locale="fr">
  <!-- Hero -->
  <section class="sec feat-hero">
    <div class="ghost num" data-ghost aria-hidden="true">03</div>
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>saisie de texte</span>
        <h1 class="feat-h1" data-animate data-animate-delay="60">Tape la séance</h1>
        <p class="feat-lead" data-animate data-animate-delay="120">
          Tape la séance comme tu la dirais à un partenaire d'entraînement. Tuwa
          transforme la phrase en brouillon modifiable, chaque série remplie, et
          rien n'atteint ton journal avant que tu confirmes. Gratuit sur toutes
          les formules.
        </p>
      </div>
    </div>
  </section>

  <!-- One line, one pipeline -->
  <section class="sec sec-alt bt">
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>comment ça marche</span>
        <h2 data-animate>Une phrase, un seul traitement</h2>
        <p data-animate>
          Tape la séance comme tu la dirais à voix haute, ou enregistre chaque
          série directement sur la réglette. Dans tous les cas, aucune syntaxe à
          apprendre, aucune formulation à réussir.
        </p>
        <p data-animate data-animate-delay="80">
          « Squat, trois séries de cinq à 130, la dernière était lourde » est une
          instruction complète.
        </p>
      </div>
      <div class="sec-body">
        <div class="spread" data-spread>
          <div class="plate" data-fan="c"><Image src={logCaptureShot} alt="Saisie de séance Tuwa : une séance tapée, écrite en une phrase, prête à être analysée" width={640} format="webp" loading="lazy" decoding="async" /></div>
        </div>
        <div class="aside quote" data-animate data-quote>
          <div class="quote-rule"></div>
          <blockquote>
            Squat, trois séries de cinq à 130, la dernière était lourde. Puis
            développé couché, quatre fois huit à quatre-vingts.
          </blockquote>
          <p style="margin-top:16px">Une phrase. Sept séries, posées, prêtes pour ton coup d'œil.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Draft, then confirm -->
  <section class="sec bt">
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>le brouillon</span>
        <h2 data-animate>Rien ne s'enregistre tout seul</h2>
        <p data-animate>
          L'analyse n'écrit pas dans ton journal. Elle ouvre l'écran de saisie
          habituel avec les séries déjà en place, et chacune reste à toi : la
          réglette de charge montre toute son étendue, ta dernière série et la
          cible du jour marquées dessus, et le sélecteur de répétitions n'a pas
          bougé.
        </p>
        <p data-animate data-animate-delay="80">
          C'est la discipline que suit déjà le verdict quotidien. Tuwa propose, tu
          confirmes — et si l'analyse a lu « quatre-vingts » sur le mauvais
          mouvement, corriger prend une touche, pas une phrase à retaper.
        </p>
      </div>
      <div class="sec-body">
        <div class="spread" data-spread>
          <div class="plate" data-fan="c"><Image src={activeWorkoutShot} alt="Saisie des séries dans Tuwa : la réglette de charge avec les repères cible et dernière série" width={640} format="webp" loading="lazy" decoding="async" /></div>
        </div>
        <div class="aside quote" data-animate data-quote>
          <div class="quote-rule"></div>
          <blockquote>
            La saisie manuelle ne disparaît jamais. C'est par elle qu'on corrige,
            et elle reste la plus rapide pour une série entre deux tours.
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- Mid-session -->
  <section class="sec sec-alt bt">
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>en pleine séance</span>
        <h2 data-animate>Une série à la fois, sans quitter la liste</h2>
        <p data-animate>
          Dans une séance en cours, tu peux taper une série dès que tu la
          termines. La capture reste dans la page — la liste des séries ne
          disparaît jamais derrière un panneau — et la série arrive dans
          l'exercice ouvert.
        </p>
        <p data-animate data-animate-delay="80">
          Rien d'autre ne change dans le journal. Les modèles reportent les
          cibles, les records personnels sont toujours détectés, et la banque de
          1 324 mouvements reste à une recherche.
        </p>
      </div>
    </div>
  </section>

  <!-- What leaves the phone -->
  <section class="sec bt">
    <div class="wrap">
      <div class="sec-head">
        <span class="micro" data-animate>ce qui quitte ton téléphone</span>
        <h2 data-animate>La phrase est traitée sur un serveur. Ta physiologie, non.</h2>
        <p data-animate>
          Transformer une phrase en séries structurées n'est pas un calcul qu'un
          téléphone fait seul : le texte de séance que tu tapes part donc vers
          le service d'analyse de Tuwa et est traité par un modèle de langue
          tiers. Les requêtes sont liées à ton compte connecté et plafonnées par
          un quota quotidien.
        </p>
        <p data-animate data-animate-delay="80">
          Ce chemin ne transporte que la description de la séance, rien d'autre.
          Les données HealthKit brutes — VFC, fréquence cardiaque au repos,
          sommeil — sont lues sur ton téléphone et n'en sortent jamais, avant
          cette fonction comme après. Le détail complet est sur la
          <a href="/fr/privacy">politique de confidentialité</a>.
        </p>
      </div>
    </div>
  </section>

  <FeatureFaq heading="Questions fréquentes" faqs={faqs} />

  <FeatureClosing
    heading="Tape-la une fois, vérifie, continue"
    body="Télécharge Tuwa pour noter au clavier ou à la main — et obtenir le verdict du jour sur le plan que tu as écrit."
    ctaNote="iOS 17+ · iPhone"
    ctaLabel="Télécharger sur l'App Store"
    relatedAriaLabel="Pages liées"
    related={[
      { label: 'Journal et modèles', href: '/fr/features/smart-templates' },
      { label: 'Le verdict quotidien', href: '/fr/features/verdict' },
      { label: 'Score de récupération', href: '/fr/features/recovery-scoring' },
      { label: 'Politique de confidentialité', href: '/fr/privacy' },
    ]}
  />

  <script>
    import '../../../scripts/featureMotion.ts';
  </script>
</BaseLayout>
