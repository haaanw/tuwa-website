---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from './BaseLayout.astro';
import FeatureCTA from '../components/FeatureCTA.astro';
import type { TopicPageContent } from '../i18n/topicPage';

interface Props {
  content: TopicPageContent;
  ogImage?: string;
  shapeId?: string;
  locale?: string;
  structuredData?: Record<string, unknown>[];
}

const { content, ogImage, locale = 'en', structuredData } = Astro.props;
const { meta, hero, sections, related, references } = content;
---
<BaseLayout
  title={meta.title}
  description={meta.description}
  ogImage={ogImage}
  locale={locale}
  structuredData={structuredData}
>
  <!-- Hero -->
  <section data-animate class="topic-hero-with-art">
    <div class="mx-auto text-center" style="width: 100%; max-width: 768px; box-sizing: border-box; padding: 0 var(--space-md); position: relative; z-index: 1;">
      <h1
        style="
          font-family: var(--font-display);
          font-size: var(--text-display);
          font-weight: var(--weight-display);
          line-height: var(--leading-display);
          letter-spacing: var(--tracking-display);
          color: var(--color-text-1);
        "
      >
        {hero.outcomeStatement}
      </h1>
      <p
        class="mx-auto"
        style="
          margin-top: var(--space-lg);
          max-width: 560px;
          font-size: var(--text-lede);
          line-height: var(--leading-heading);
          color: var(--color-text-2);
        "
      >
        {hero.hookLine}
      </p>
      <!-- accent rule anchors the hero below the hook line -->
      <div aria-hidden="true" style="width: 56px; height: 2px; background: var(--color-accent); margin: var(--space-xl) auto 0;"></div>
    </div>
  </section>

  <!-- Content sections — magazine grid: heading rail + reading column -->
  {sections.map((section, i) => (
    <section
      data-animate
      class={i % 2 === 1 ? '' : 'section-spaced'}
      style={i % 2 === 1
        ? 'background-color: var(--color-surface); border-top: 1px solid var(--color-divider); border-bottom: 1px solid var(--color-divider);'
        : ''}
    >
      <div class={i % 2 === 1 ? 'section-spaced mx-auto max-w-5xl px-6' : 'mx-auto max-w-5xl px-6'}>
        <div class="topic-grid">
          <h2 class="topic-kicker">{section.heading}</h2>
          <div>
            {section.subheading && <h3 class="prose-h3" style="margin-top: 0;">{section.subheading}</h3>}
            {section.body.map((para, p) => (
              <p class={p === 0 ? 'prose-lede' : 'prose-p'}>{para}</p>
            ))}
            {section.comparison && (
              <table class="compare-table">
                <thead>
                  <tr>
                    <th scope="col">{section.comparison.columns[0]}</th>
                    <th scope="col">{section.comparison.columns[1]}</th>
                    <th scope="col" class="col-tuwa">{section.comparison.columns[2]}</th>
                  </tr>
                </thead>
                <tbody>
                  {section.comparison.rows.map((row) => (
                    <tr>
                      <td>{row.label}</td>
                      <td>{row.generic}</td>
                      <td class="col-tuwa">{row.tuwa}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            {section.bullets && (
              <ul class="signal-cards">
                {section.bullets.map((item) => (
                  <li class="signal-card">{item}</li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- Related links — card grid -->
  {related && (
    <section data-animate class="section-spaced">
      <div class="mx-auto max-w-5xl px-6">
        <h2
          style="
            font-size: var(--text-heading);
            font-weight: var(--weight-heading);
            line-height: var(--leading-heading);
            letter-spacing: var(--tracking-heading);
            color: var(--color-text-1);
            margin-bottom: var(--space-lg);
          "
        >
          {related.heading}
        </h2>
        <ul class="related-grid">
          {related.links.map((link) => (
            <li>
              <a href={getRelativeLocaleUrl(locale, link.href)} class="related-card">
                <span>{link.label}</span>
                <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- References -->
  {references && (
    <section data-animate style="background-color: var(--color-surface); border-top: 1px solid var(--color-divider);">
      <div class="section-spaced mx-auto max-w-5xl px-6">
        <h2
          style="
            font-size: var(--text-heading);
            font-weight: var(--weight-heading);
            line-height: var(--leading-heading);
            letter-spacing: var(--tracking-heading);
            color: var(--color-text-1);
            margin-bottom: var(--space-lg);
          "
        >
          {references.heading}
        </h2>
        <ol class="references-list">
          {references.items.map((ref) => (
            <li>
              <a href={ref.url} target="_blank" rel="noopener noreferrer nofollow" class="content-link">
                {ref.label}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <FeatureCTA locale={locale} />
</BaseLayout>
