---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../i18n/format';
import type { Locale } from '../i18n/utils';
import { articleSchema, faqPageSchema } from '../seo/schema';
import { coverMark } from '../components/blog/figures';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  date: Date;
  updated?: Date;
  slug?: string;
  faq?: ReadonlyArray<{ q: string; a: string }>;
  minutesRead?: string;
  /** Standfirst. Falls back to `description`, which is what the old layout showed. */
  deck?: string;
  /** Kicker — the article's class per SCIENCE-SERIES.md rule 0. */
  articleClass?: string;
  /** Position in the series, e.g. 1 renders "No. 01". */
  seriesNo?: number;
  /** Counted from the article's own source list at build time, never authored. */
  sourceCount?: number;
}

const {
  title, description, ogImage, date, updated, slug, faq, minutesRead,
  deck, articleClass, seriesNo, sourceCount,
} = Astro.props;
const locale = (Astro.currentLocale ?? 'en') as Locale;

// GEO: answer engines quote structured data verbatim, so every article carries an
// Article anchor and — where the post asks question-shaped headings — a FAQPage.
// `date` is publication; `updated` is the last substantive revision.
// UNCHANGED from the previous layout: this port moves presentation only.
const canonicalUrl = slug ? `https://tuwa.app/blog/${slug}/` : 'https://tuwa.app/blog/';
const structuredData = [
  articleSchema({
    title,
    description,
    url: canonicalUrl,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    image: ogImage,
  }),
  ...(faq && faq.length > 0 ? [faqPageSchema(faq)] : []),
];

const L = {
  en: { series: 'Tuwa · training science', read: 'min read', sources: 'sources',
        updated: 'Updated', decay: "DECAY OF ONE SESSION'S WEIGHT · 1/7 PER DAY" },
  zh: { series: 'Tuwa · 训练科学', read: '分钟阅读', sources: '条参考文献',
        updated: '更新于', decay: '单次训练权重的衰减 · 每天 1/7' },
  fr: { series: 'Tuwa · science de l’entraînement', read: 'min de lecture', sources: 'sources',
        updated: 'Mis à jour', decay: "DÉCROISSANCE DU POIDS D'UNE SÉANCE · 1/7 PAR JOUR" },
}[locale] ?? { series: 'Tuwa · training science', read: 'min read', sources: 'sources',
               updated: 'Updated', decay: "DECAY OF ONE SESSION'S WEIGHT · 1/7 PER DAY" };

// `minutesRead` arrives from the remark plugin as e.g. "12 min read"; the byline
// sets its own label, so take the leading number and drop the plugin's wording.
const minutes = minutesRead ? minutesRead.replace(/[^\d]/g, '') : null;
const seriesLabel = seriesNo != null ? `No. ${String(seriesNo).padStart(2, '0')}` : null;
---
<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  type="article"
  locale={locale}
  hreflangAlternates={[]}
  structuredData={structuredData}
>
  {/* The reading voice is ~268 KB across two files and is used on articles ONLY,
      so it preloads here rather than in BaseLayout — no other page pays for it. */}
  <Fragment slot="head">
    <link rel="preload" href="/fonts/Newsreader.woff2" as="font" type="font/woff2" crossorigin />
  </Fragment>

  <div class="article-cover">
    <div class="article-cover-inner">
      <div class="article-cover-rail">
        <span class="series">
          {L.series}{seriesLabel ? ` · ${seriesLabel}` : ''}
        </span>
        <span>
          {articleClass ? `${articleClass} · ` : ''}
          <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
        </span>
      </div>

      <div class="article-cover-art">
        <div set:html={coverMark()} />
        <div class="anno-caption">{L.decay}</div>
      </div>

      <h1>{title}</h1>
      <p class="article-deck">{deck ?? description}</p>

      <div class="article-byline">
        <span>Tuwa</span>
        {minutes && <span>{minutes} {L.read}</span>}
        {sourceCount ? <span>{sourceCount} {L.sources}</span> : null}
        {updated && (
          <span>{L.updated} <time datetime={updated.toISOString()}>{formatDate(updated, locale)}</time></span>
        )}
      </div>
    </div>
  </div>

  <div class="article-wrap">
    <article class="article-body">
      <slot />
    </article>
  </div>
</BaseLayout>
