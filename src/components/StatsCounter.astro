---
import { useHomeTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useHomeTranslations(locale);
const tiles = [
  { ...t.stats.science, mark: '01' },
  { ...t.stats.privacy, mark: '02' },
  { ...t.stats.dayOne, mark: '03' },
];
---
<section
  aria-label={t.stats.heading}
  data-animate
  class="proof-section"
  style="
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-divider);
    border-bottom: 1px solid var(--color-divider);
  "
>
  <div
    class="mx-auto max-w-6xl px-6"
    style="padding-top: var(--space-2xl); padding-bottom: var(--space-2xl);"
  >
    <h2
      class="text-center"
      style="
        font-size: var(--text-heading);
        font-weight: var(--weight-heading);
        line-height: var(--leading-heading);
        letter-spacing: var(--tracking-heading);
        color: var(--color-text-1);
        margin-bottom: var(--space-2xl);
      "
    >
      {t.stats.heading}
    </h2>
    <div class="proof-grid">
      {tiles.map((tile) => (
        <div class="proof-tile">
          <span class="proof-mark" aria-hidden="true">{tile.mark}</span>
          <h3
            style="
              font-size: var(--text-subheading);
              font-weight: var(--weight-heading);
              line-height: var(--leading-subheading);
              color: var(--color-text-1);
            "
          >
            {tile.title}
          </h3>
          <p
            style="
              margin-top: var(--space-sm);
              color: var(--color-text-2);
              line-height: var(--leading-body);
            "
          >
            {tile.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
