---
// No frontmatter imports -- Chart.js loaded in bundled script tag
---
<figure style="max-width: 640px; margin: 0 auto; padding: var(--space-lg); background: color-mix(in srgb, var(--color-bg) 55%, #ffffff); border: 1px solid var(--color-divider); border-radius: var(--radius-lg);">
  <h3 style="font-size: var(--text-subheading); font-weight: var(--weight-heading); line-height: var(--leading-subheading); color: var(--color-text-1); margin: 0 0 var(--space-md);">
    What makes up your recovery score
  </h3>
  <!-- Reserved aspect-ratio box prevents layout shift before Chart.js paints (CLS fix) -->
  <div style="position: relative; width: 100%; aspect-ratio: 2 / 1;">
    <canvas
      id="recovery-chart"
      aria-label="Bar chart showing recovery score components: HRV contribution, resting heart rate, sleep quality, and wellness check-in"
      role="img"
      style="position: absolute; inset: 0;"
    ></canvas>
  </div>
</figure>

<script>
  import Chart from 'chart.js/auto';

  const COLOR_ACCENT = '#2B5240';
  const COLOR_TEXT_2 = '#696560';
  const COLOR_GRID = 'rgba(207,203,197,0.5)';
  const COLOR_INK = '#1C1915';
  const REDUCED_MOTION = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Brand-harmonized Chart.js defaults
  Chart.defaults.font.family = "'General Sans', system-ui, sans-serif";
  Chart.defaults.font.size = 13;
  Chart.defaults.color = COLOR_TEXT_2;

  const canvas = document.getElementById('recovery-chart') as HTMLCanvasElement;
  if (canvas) {
    new Chart(canvas, {
      type: 'bar',
      data: {
        labels: ['HRV', 'Resting HR', 'Sleep', 'Wellness'],
        datasets: [
          {
            label: 'Recovery Score Contribution',
            data: [28, 22, 18, 10],
            backgroundColor: [COLOR_ACCENT, COLOR_ACCENT, COLOR_ACCENT, COLOR_ACCENT],
            borderRadius: 4,
            barPercentage: 0.6,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: REDUCED_MOTION ? false : undefined,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: COLOR_INK,
            titleColor: '#F4F1ED',
            bodyColor: '#F4F1ED',
            padding: 12,
            cornerRadius: 6,
            displayColors: false,
            callbacks: {
              label: function (context) {
                return context.parsed.y + ' points';
              },
            },
          },
        },
        scales: {
          y: {
            beginAtZero: true,
            max: 35,
            grid: { color: COLOR_GRID, lineWidth: 1 },
            border: { display: false },
            ticks: { color: COLOR_TEXT_2, font: { size: 13 } },
            title: {
              display: true,
              text: 'Score Contribution',
              color: COLOR_TEXT_2,
              font: { size: 13 },
            },
          },
          x: {
            grid: { display: false },
            border: { color: COLOR_GRID },
            ticks: { color: COLOR_TEXT_2, font: { size: 13 } },
          },
        },
      },
    });
  }
</script>
