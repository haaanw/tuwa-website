---
// No frontmatter imports -- Chart.js loaded in bundled script tag
---
<figure class="chart-figure" style="max-width: 640px; margin: 0 auto; padding: var(--space-lg); background: color-mix(in srgb, var(--color-bg) 55%, #ffffff); border: 1px solid var(--color-divider); border-radius: 0;">
  <h3 style="font-size: var(--text-subheading); font-weight: var(--weight-heading); line-height: var(--leading-subheading); color: var(--color-text-1); margin: 0 0 var(--space-md);">
    What makes up your recovery score
  </h3>
  <!-- Reserved aspect-ratio box prevents layout shift before Chart.js paints (CLS fix) -->
  <div class="chart-canvas-wrap" style="position: relative; width: 100%; aspect-ratio: 2 / 1;">
    <canvas
      id="recovery-chart"
      aria-label="Bar chart showing recovery score components: HRV contribution, resting heart rate, sleep quality, and wellness check-in"
      role="img"
      style="position: absolute; inset: 0;"
    ></canvas>
  </div>
  <figcaption class="chart-caption">
    HRV, resting heart rate, sleep, and wellness each contribute context; no single metric gets to overrule the whole day.
  </figcaption>
  <noscript>
    <table style="margin-top: var(--space-md); width: 100%; border-collapse: collapse; font-size: var(--text-label); color: var(--color-text-2);">
      <thead>
        <tr><th scope="col" style="text-align: left; padding: var(--space-sm); border-bottom: 1px solid var(--color-divider);">Signal</th><th scope="col" style="text-align: left; padding: var(--space-sm); border-bottom: 1px solid var(--color-divider);">Score contribution</th></tr>
      </thead>
      <tbody>
        <tr><td style="padding: var(--space-sm);">HRV</td><td style="padding: var(--space-sm);">28 points</td></tr>
        <tr><td style="padding: var(--space-sm);">Resting HR</td><td style="padding: var(--space-sm);">22 points</td></tr>
        <tr><td style="padding: var(--space-sm);">Sleep</td><td style="padding: var(--space-sm);">18 points</td></tr>
        <tr><td style="padding: var(--space-sm);">Wellness</td><td style="padding: var(--space-sm);">10 points</td></tr>
      </tbody>
    </table>
  </noscript>
</figure>

<script>
  const COLOR_ACCENT = '#2E6B86';
  const COLOR_TEXT_2 = '#696560';
  const COLOR_GRID = 'rgba(207,203,197,0.5)';
  const COLOR_INK = '#1C1915';
  const REDUCED_MOTION = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const canvas = document.getElementById('recovery-chart') as HTMLCanvasElement;

  // Defer the ~72KB Chart.js chunk until the chart scrolls near the viewport (perf).
  async function buildChart() {
    const { default: Chart } = await import('chart.js/auto');
    Chart.defaults.font.family = "'General Sans', system-ui, sans-serif";
    Chart.defaults.font.size = 13;
    Chart.defaults.color = COLOR_TEXT_2;
    new Chart(canvas, {
      type: 'bar',
      data: {
        labels: ['HRV', 'Resting HR', 'Sleep', 'Wellness'],
        datasets: [
          {
            label: 'Recovery Score Contribution',
            data: [28, 22, 18, 10],
            backgroundColor: [COLOR_ACCENT, COLOR_ACCENT, COLOR_ACCENT, COLOR_ACCENT],
            borderRadius: 4,
            barPercentage: 0.6,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: REDUCED_MOTION ? false : undefined,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: COLOR_INK,
            titleColor: '#ECEEF1',
            bodyColor: '#ECEEF1',
            padding: 12,
            cornerRadius: 6,
            displayColors: false,
            callbacks: {
              label: function (context) {
                return context.parsed.y + ' points';
              },
            },
          },
        },
        scales: {
          y: {
            beginAtZero: true,
            max: 35,
            grid: { color: COLOR_GRID, lineWidth: 1 },
            border: { display: false },
            ticks: { color: COLOR_TEXT_2, font: { size: 13 } },
            title: {
              display: true,
              text: 'Score Contribution',
              color: COLOR_TEXT_2,
              font: { size: 13 },
            },
          },
          x: {
            grid: { display: false },
            border: { color: COLOR_GRID },
            ticks: { color: COLOR_TEXT_2, font: { size: 13 } },
          },
        },
      },
    });
  }

  if (canvas) {
    const figure = canvas.closest('figure');
    if ('IntersectionObserver' in window && figure) {
      const io = new IntersectionObserver((entries, obs) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            obs.disconnect();
            buildChart();
          }
        });
      }, { rootMargin: '200px' });
      io.observe(figure);
    } else {
      buildChart();
    }
  }
</script>
