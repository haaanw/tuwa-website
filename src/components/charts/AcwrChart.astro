---
// No frontmatter imports -- Chart.js loaded in bundled script tag
---
<figure style="max-width: 640px; margin: 0 auto; padding: var(--space-lg); background: color-mix(in srgb, var(--color-bg) 55%, #ffffff); border: 1px solid var(--color-divider); border-radius: var(--radius-lg);">
  <h3 style="font-size: var(--text-subheading); font-weight: var(--weight-heading); line-height: var(--leading-subheading); color: var(--color-text-1); margin: 0 0 var(--space-md);">
    Acute vs. chronic load over 28 days
  </h3>
  <!-- Reserved aspect-ratio box prevents layout shift before Chart.js paints (CLS fix) -->
  <div style="position: relative; width: 100%; aspect-ratio: 2 / 1;">
    <canvas
      id="acwr-chart"
      aria-label="Line chart showing 28-day training load trend with acute load in green and chronic load in grey, illustrating the ACWR ratio over time"
      role="img"
      style="position: absolute; inset: 0;"
    ></canvas>
  </div>
  <noscript>
    <p style="margin-top: var(--space-md); font-size: var(--text-label); line-height: var(--leading-body); color: var(--color-text-2);">
      Across a representative 28-day block, acute load (last ~7 days) rises and falls with each session while chronic load (last ~28 days) climbs gradually. Keeping the acute:chronic ratio inside roughly 0.8–1.3 is the safe progression zone.
    </p>
  </noscript>
</figure>

<script>
  const COLOR_ACCENT = '#2B5240';
  const COLOR_TEXT_2 = '#696560';
  const COLOR_TEXT_3 = '#6D6862';
  const COLOR_GRID = 'rgba(207,203,197,0.5)';
  const COLOR_INK = '#1C1915';
  const REDUCED_MOTION = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Representative 28-day ACWR data -- illustrates gradual load buildup with safe progression
  const labels = Array.from({ length: 28 }, (_, i) => `Day ${i + 1}`);
  const acuteLoad = [
    120, 135, 90, 150, 140, 0, 130,
    145, 160, 100, 155, 170, 0, 140,
    165, 175, 110, 180, 165, 0, 155,
    170, 185, 115, 190, 180, 0, 165,
  ];
  const chronicLoad = [
    110, 112, 113, 115, 118, 118, 119,
    121, 124, 124, 126, 129, 129, 130,
    133, 136, 136, 139, 141, 141, 142,
    145, 148, 148, 151, 153, 153, 154,
  ];

  const canvas = document.getElementById('acwr-chart') as HTMLCanvasElement;

  // Defer the ~72KB Chart.js chunk until the chart scrolls near the viewport (perf).
  async function buildChart() {
    const { default: Chart } = await import('chart.js/auto');
    Chart.defaults.font.family = "'General Sans', system-ui, sans-serif";
    Chart.defaults.font.size = 13;
    Chart.defaults.color = COLOR_TEXT_2;
    new Chart(canvas, {
      type: 'line',
      data: {
        labels,
        datasets: [
          {
            label: 'Acute Load (7-day)',
            data: acuteLoad,
            borderColor: COLOR_ACCENT,
            backgroundColor: 'transparent',
            tension: 0.3,
            pointRadius: 0,
            borderWidth: 2,
          },
          {
            label: 'Chronic Load (28-day)',
            data: chronicLoad,
            borderColor: COLOR_TEXT_3,
            backgroundColor: 'transparent',
            tension: 0.3,
            pointRadius: 0,
            borderWidth: 2,
            borderDash: [6, 3],
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: REDUCED_MOTION ? false : undefined,
        interaction: {
          mode: 'index',
          intersect: false,
        },
        plugins: {
          legend: {
            display: true,
            labels: {
              color: COLOR_TEXT_2,
              font: { size: 14 },
              usePointStyle: true,
              pointStyle: 'line',
              padding: 16,
            },
          },
          tooltip: {
            backgroundColor: COLOR_INK,
            titleColor: '#F4F1ED',
            bodyColor: '#F4F1ED',
            padding: 12,
            cornerRadius: 6,
            displayColors: false,
          },
        },
        scales: {
          y: {
            grid: { color: COLOR_GRID, lineWidth: 1 },
            border: { display: false },
            ticks: { color: COLOR_TEXT_2, font: { size: 13 } },
            title: {
              display: true,
              text: 'Training Load (AU)',
              color: COLOR_TEXT_2,
              font: { size: 13 },
            },
          },
          x: {
            grid: { display: false },
            border: { color: COLOR_GRID },
            ticks: {
              color: COLOR_TEXT_2,
              font: { size: 12 },
              maxTicksLimit: 7,
            },
          },
        },
      },
    });
  }

  if (canvas) {
    const figure = canvas.closest('figure');
    if ('IntersectionObserver' in window && figure) {
      const io = new IntersectionObserver((entries, obs) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            obs.disconnect();
            buildChart();
          }
        });
      }, { rootMargin: '200px' });
      io.observe(figure);
    } else {
      buildChart();
    }
  }
</script>
