---
// Pavilion feature-page closing — the page's one ink CTA plus a quiet
// related-pages row. #closeCta pairs with featureMotion.ts, which hides the
// header pill while this one is on screen (one ink pill per screenful).
import { APP_STORE_URL } from '../../config';

interface Props {
  heading: string;
  body?: string;
  ctaNote: string;
  related: ReadonlyArray<{ label: string; href: string }>;
  /* Localized pages pass translated labels; EN pages rely on the defaults. */
  ctaLabel?: string;
  relatedAriaLabel?: string;
}
const {
  heading,
  body,
  ctaNote,
  related,
  ctaLabel = 'Download on the App Store',
  relatedAriaLabel = 'Related pages',
} = Astro.props;
---
<section class="sec bt">
  <div class="wrap">
    <div class="sec-head">
      <h2 data-animate>{heading}</h2>
      {body && <p data-animate>{body}</p>}
    </div>
    <div class="closing-cta" data-animate>
      <a class="pill-ink" id="closeCta" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">
        {ctaLabel}
      </a>
      <span class="micro">{ctaNote}</span>
    </div>
    <nav class="related-row micro" aria-label={relatedAriaLabel}>
      {related.map((link, i) => (
        <>
          {i > 0 && <span class="f-tick" aria-hidden="true"></span>}
          <a href={link.href}>{link.label}</a>
        </>
      ))}
    </nav>
  </div>
</section>
