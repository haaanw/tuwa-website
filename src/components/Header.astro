---
// Minimal demo-d nav: wordmark + the one ink pill. All page navigation lives
// in the footer (see Footer.astro). On the homepage, homeMotion.ts hides the
// pill (#navCta) while another ink CTA is on screen — one pill per screenful.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/utils';
import { APP_STORE_URL } from '../config';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const t = useTranslations(locale as 'en' | 'zh' | 'fr');
---
<header class="site-nav">
  <nav class="site-nav-inner" aria-label="Main">
    <a class="wordmark" href={getRelativeLocaleUrl(locale, '/')} aria-label="Tuwa home">Tuwa</a>
    <a
      class="pill-ink pill-ink-sm"
      id="navCta"
      href={APP_STORE_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t.featureCTA.badgeAriaLabel}
    >
      {t.nav.getApp}
    </a>
  </nav>
</header>
