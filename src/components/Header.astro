---
// Minimal demo-d nav: wordmark + quiet "Menu" text button (opens NavDrawer)
// on the left, the one ink pill on the right. Full page navigation lives in
// the drawer + footer (footer stays canonical for no-JS). On the homepage,
// homeMotion.ts hides the pill (#navCta) while another ink CTA is on screen —
// one pill per screenful. NavDrawer is mounted here, as a SIBLING of <header>,
// so the open-state `inert` on header/main/footer never swallows the dialog.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/utils';
import { APP_STORE_URL } from '../config';
import NavDrawer from './NavDrawer.astro';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const t = useTranslations(locale as 'en' | 'zh' | 'fr');

// Homepage-only anchor nav (HAN, 2026-08-01): the demo's section links, shown
// ONLY where the sections exist. Every other page keeps wordmark + Menu + pill.
const homePaths = ['/', '/zh', '/zh/', '/fr', '/fr/'];
const isHome = homePaths.includes(Astro.url.pathname);
---
<header class="site-nav">
  <nav class="site-nav-inner" aria-label="Main">
    <div class="site-nav-left">
      <a class="wordmark" href={getRelativeLocaleUrl(locale, '/')} aria-label="Tuwa home">Tuwa</a>
      <button
        class="nav-menu-btn"
        id="navMenuBtn"
        type="button"
        aria-expanded="false"
        aria-controls="navDrawer"
      >
        {t.nav.menu}
      </button>
    </div>
    {isHome && (
      <div class="nav-anchors" aria-label="Sections">
        {t.nav.anchors.map((a) => (
          <a class="nav-anchor" href={a.href}>{a.label}</a>
        ))}
      </div>
    )}
    <a
      class="pill-ink pill-ink-sm"
      id="navCta"
      href={APP_STORE_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t.featureCTA.badgeAriaLabel}
    >
      {t.nav.getApp}
    </a>
  </nav>
</header>
<NavDrawer locale={locale} />
