---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/utils';
import { APP_STORE_URL } from '../config';
import MobileMenu from "./MobileMenu.astro";

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;

const t = useTranslations(locale as 'en' | 'zh' | 'fr');

// Path-preserving locale switch: strip current locale prefix to get bare path
const rawPath = Astro.url.pathname;
const knownLocales = ['en', 'zh', 'fr'];
const pathSegments = rawPath.split('/');
const pathWithoutLocale = knownLocales.includes(pathSegments[1])
  ? '/' + pathSegments.slice(2).join('/')
  : rawPath;

const LOCALES = [
  { code: 'en', label: t.nav.languageSwitcher.en },
  { code: 'zh', label: t.nav.languageSwitcher.zh },
  { code: 'fr', label: t.nav.languageSwitcher.fr },
] as const;

const ENGLISH_ONLY_PATH_PREFIXES = [
  '/strength-readiness-calculator',
  '/weekly-training-review-template',
  '/apple-watch-training-load-for-lifters',
  '/guides/',
  '/comparisons/',
];
const isEnglishOnlyPath = ENGLISH_ONLY_PATH_PREFIXES.some((prefix) =>
  rawPath === prefix || rawPath.startsWith(prefix)
);
const availableLocales = isEnglishOnlyPath ? LOCALES.filter(({ code }) => code === 'en') : LOCALES;
const showLanguageSwitcher = availableLocales.length > 1;
---
<header
  class="sticky top-0 z-50 border-b"
  style="
    height: 64px;
    background-color: color-mix(in srgb, var(--color-surface) 85%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-color: var(--color-divider);
  "
>
  <nav
    class="mx-auto flex h-full max-w-6xl items-center justify-between px-6"
    aria-label="Main navigation"
  >
    <a
      href={getRelativeLocaleUrl(locale, '/')}
      aria-label="Tuwa home"
      class="nav-logo"
    >
      Tuwa
    </a>

    <!-- Mobile language switcher (hidden on desktop) -->
    {showLanguageSwitcher && (
    <div class="relative flex items-center md:hidden" id="lang-dropdown-mobile">
      <button
        type="button"
        class="nav-link flex items-center gap-1"
        aria-expanded="false"
        aria-haspopup="true"
        aria-label={t.nav.languageSwitcher.label}
        style="padding: 8px; min-height: 48px;"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
             aria-hidden="true">
          <circle cx="8" cy="8" r="6.5"/>
          <path d="M8 1.5C8 1.5 5.5 4 5.5 8s2.5 6.5 2.5 6.5"/>
          <path d="M8 1.5C8 1.5 10.5 4 10.5 8s-2.5 6.5-2.5 6.5"/>
          <path d="M1.5 8h13"/>
        </svg>
        <span style="font-size: var(--text-label); font-weight: var(--weight-label);">
          {t.nav.languageSwitcher.current}
        </span>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="nav-chevron" style="margin-top: 1px;">
          <polyline points="2,4 6,8 10,4" />
        </svg>
      </button>
      <div class="nav-dropdown" aria-label={t.nav.languageSwitcher.label} style="width: 160px;">
        {availableLocales.map(({ code, label }) => (
          <a
            href={getRelativeLocaleUrl(code, pathWithoutLocale)}
            class="nav-dropdown-item"
            aria-current={code === locale ? 'true' : undefined}
            style={code === locale ? 'color: var(--color-accent);' : ''}
          >
            {label}
          </a>
        ))}
      </div>
    </div>
    )}

    <!-- Desktop nav links -->
    <!-- gap tightened at md so longer locales (fr) fit at the 768px breakpoint; full gap restored at lg -->
    <ul class="hidden items-center gap-5 lg:gap-8 md:flex" role="list">
      <li class="relative" id="features-dropdown">
        <button
          type="button"
          class="nav-link flex items-center gap-1"
          aria-expanded="false"
          aria-haspopup="true"
        >
          {t.nav.features}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="nav-chevron" style="margin-top: 1px;">
            <polyline points="2,4 6,8 10,4" />
          </svg>
        </button>
        <div class="nav-dropdown" aria-label={t.nav.features}>
          <a href={getRelativeLocaleUrl(locale, '/features/smart-templates')} class="nav-dropdown-item">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 4h6l1 2h3v15H5V6h3l1-2z" />
              <path d="M9 10h6M9 14h6M9 18h4" />
            </svg>
            <div>
              <span class="nav-dropdown-title">{t.nav.featuresDropdown.smartTemplatesTitle}</span>
              <span class="nav-dropdown-desc">{t.nav.featuresDropdown.smartTemplatesDesc}</span>
            </div>
          </a>
          <a href={getRelativeLocaleUrl(locale, '/features/workload-tracking')} class="nav-dropdown-item">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 12h16" />
              <path d="M7 9v6M17 9v6" />
              <path d="M2 10v4M22 10v4" />
            </svg>
            <div>
              <span class="nav-dropdown-title">{t.nav.featuresDropdown.workloadTrackingTitle}</span>
              <span class="nav-dropdown-desc">{t.nav.featuresDropdown.workloadTrackingDesc}</span>
            </div>
          </a>
          <a href={getRelativeLocaleUrl(locale, '/features/recovery-scoring')} class="nav-dropdown-item">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.8 8.6c0 4.8-8.8 10.4-8.8 10.4S3.2 13.4 3.2 8.6A4.6 4.6 0 0 1 12 6.7a4.6 4.6 0 0 1 8.8 1.9z" />
              <path d="M8 12h2l1-2 2 4 1-2h2" />
            </svg>
            <div>
              <span class="nav-dropdown-title">{t.nav.featuresDropdown.recoveryScoringTitle}</span>
              <span class="nav-dropdown-desc">{t.nav.featuresDropdown.recoveryScoringDesc}</span>
            </div>
          </a>
          <a href={getRelativeLocaleUrl(locale, '/training-load')} class="nav-dropdown-item">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19V5" />
              <path d="M4 19h16" />
              <path d="M8 15l3-3 3 2 4-6" />
            </svg>
            <div>
              <span class="nav-dropdown-title">{t.nav.featuresDropdown.backRoomTitle}</span>
              <span class="nav-dropdown-desc">{t.nav.featuresDropdown.backRoomDesc}</span>
            </div>
          </a>
          <a href={getRelativeLocaleUrl(locale, '/features/cold-start')} class="nav-dropdown-item">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13 2 5 14h6l-1 8 8-12h-6l1-8z"/>
            </svg>
            <div>
              <span class="nav-dropdown-title">{t.nav.featuresDropdown.coldStartTitle}</span>
              <span class="nav-dropdown-desc">{t.nav.featuresDropdown.coldStartDesc}</span>
            </div>
          </a>
        </div>
      </li>
      <li>
        <a href={getRelativeLocaleUrl(locale, '/methodology')} class="nav-link">{t.nav.method}</a>
      </li>
      {locale === 'en' && (
        <li>
          <a href="/strength-readiness-calculator" class="nav-link">Calculator</a>
        </li>
      )}
      <li>
        <a href={getRelativeLocaleUrl(locale, '/blog')} class="nav-link">{t.nav.blog}</a>
      </li>
      <li>
        <a href={getRelativeLocaleUrl(locale, '/support')} class="nav-link">{t.nav.support}</a>
      </li>
      {showLanguageSwitcher && (
      <li class="relative" id="lang-dropdown">
        <button
          type="button"
          class="nav-link flex items-center gap-1"
          aria-expanded="false"
          aria-haspopup="true"
          aria-label={t.nav.languageSwitcher.label}
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
               stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
               aria-hidden="true">
            <circle cx="8" cy="8" r="6.5"/>
            <path d="M8 1.5C8 1.5 5.5 4 5.5 8s2.5 6.5 2.5 6.5"/>
            <path d="M8 1.5C8 1.5 10.5 4 10.5 8s-2.5 6.5-2.5 6.5"/>
            <path d="M1.5 8h13"/>
          </svg>
          <span style="font-size: var(--text-label); font-weight: var(--weight-label); letter-spacing: var(--tracking-label);">
            {t.nav.languageSwitcher.current}
          </span>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="nav-chevron" style="margin-top: 1px;">
            <polyline points="2,4 6,8 10,4" />
          </svg>
        </button>
        <div class="nav-dropdown" aria-label={t.nav.languageSwitcher.label} style="width: 160px;">
          {availableLocales.map(({ code, label }) => (
            <a
              href={getRelativeLocaleUrl(code, pathWithoutLocale)}
              class="nav-dropdown-item"
              aria-current={code === locale ? 'true' : undefined}
              style={code === locale ? 'color: var(--color-accent);' : ''}
            >
              {label}
              {code === locale && (
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="margin-left: auto; flex-shrink: 0;">
                  <polyline points="2,7 5.5,10.5 12,3.5"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </li>
      )}
    </ul>

    <!-- CTA button -->
    <a
      href={APP_STORE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-cta hidden md:inline-flex items-center"
      aria-label={t.featureCTA.badgeAriaLabel}
    >
      {t.nav.getApp}
    </a>

    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open navigation menu"
      class="flex items-center justify-center md:hidden"
      style="width: 44px; height: 44px; background: none; border: none; cursor: pointer; color: var(--color-text-1);"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </nav>
</header>

<MobileMenu locale={locale} />

<!-- Features dropdown toggle -->
<script is:inline>
  (function() {
    var dropdown = document.getElementById('features-dropdown');
    if (!dropdown) return;
    var btn = dropdown.querySelector('button');
    var menu = dropdown.querySelector('.nav-dropdown');
    var chevron = btn.querySelector('.nav-chevron');

    function open() {
      document.dispatchEvent(new CustomEvent('tuwa:dropdown-open', { detail: dropdown.id }));
      menu.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      chevron.style.transform = 'rotate(180deg)';
    }

    function close() {
      menu.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
      chevron.style.transform = '';
    }

    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      if (menu.classList.contains('is-open')) {
        close();
      } else {
        open();
      }
    });

    // Hover open/close with delay
    var closeTimer = null;
    dropdown.addEventListener('mouseenter', function() {
      clearTimeout(closeTimer);
      open();
    });
    dropdown.addEventListener('mouseleave', function() {
      closeTimer = setTimeout(close, 200);
    });

    // Close on outside click
    document.addEventListener('click', function(e) {
      if (!dropdown.contains(e.target)) {
        close();
      }
    });
    dropdown.addEventListener('focusout', function(e) {
      if (!dropdown.contains(e.relatedTarget)) {
        close();
      }
    });
    document.addEventListener('tuwa:dropdown-open', function(e) {
      if (e.detail !== dropdown.id) close();
    });

    // Close on Escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) {
        close();
        btn.focus();
      }
    });
  })();
</script>

<!-- Language switcher dropdown toggle (desktop) -->
<script is:inline>
  (function() {
    var dropdown = document.getElementById('lang-dropdown');
    if (!dropdown) return;
    var btn = dropdown.querySelector('button');
    var menu = dropdown.querySelector('.nav-dropdown');
    var chevron = btn.querySelector('.nav-chevron');

    function open() {
      document.dispatchEvent(new CustomEvent('tuwa:dropdown-open', { detail: dropdown.id }));
      menu.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      if (chevron) chevron.style.transform = 'rotate(180deg)';
    }

    function close() {
      menu.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
      if (chevron) chevron.style.transform = '';
    }

    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      menu.classList.contains('is-open') ? close() : open();
    });

    var closeTimer = null;
    dropdown.addEventListener('mouseenter', function() { clearTimeout(closeTimer); open(); });
    dropdown.addEventListener('mouseleave', function() { closeTimer = setTimeout(close, 200); });
    document.addEventListener('click', function(e) { if (!dropdown.contains(e.target)) close(); });
    dropdown.addEventListener('focusout', function(e) { if (!dropdown.contains(e.relatedTarget)) close(); });
    document.addEventListener('tuwa:dropdown-open', function(e) { if (e.detail !== dropdown.id) close(); });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) { close(); btn.focus(); }
    });
  })();
</script>

<!-- Language switcher dropdown toggle (mobile) -->
<script is:inline>
  (function() {
    var dropdown = document.getElementById('lang-dropdown-mobile');
    if (!dropdown) return;
    var btn = dropdown.querySelector('button');
    var menu = dropdown.querySelector('.nav-dropdown');
    var chevron = btn.querySelector('.nav-chevron');

    function open() {
      document.dispatchEvent(new CustomEvent('tuwa:dropdown-open', { detail: dropdown.id }));
      menu.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      if (chevron) chevron.style.transform = 'rotate(180deg)';
    }

    function close() {
      menu.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
      if (chevron) chevron.style.transform = '';
    }

    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      menu.classList.contains('is-open') ? close() : open();
    });

    document.addEventListener('click', function(e) { if (!dropdown.contains(e.target)) close(); });
    dropdown.addEventListener('focusout', function(e) { if (!dropdown.contains(e.relatedTarget)) close(); });
    document.addEventListener('tuwa:dropdown-open', function(e) { if (e.detail !== dropdown.id) close(); });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) { close(); btn.focus(); }
    });
  })();
</script>
