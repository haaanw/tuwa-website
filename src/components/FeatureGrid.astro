---
import { useHomeTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useHomeTranslations(locale);

const featuresData = t.featureGrid.features.map((f) => ({
  title: f.title,
  desc: f.desc,
  href: getRelativeLocaleUrl(locale, f.href),
}));

const featureLoopIcons = [
  '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h6l1 2h3v15H5V6h3l1-2zM9 10h6v1H9zm0 4h6v1H9zm0 4h4v1H9z"/></svg>',
  '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h16v2H4zM6 8h2v8H6zm10 0h2v8h-2zM1 10h3v4H1zm19 0h3v4h-3z"/></svg>',
  '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5 10.7 19C6 14.8 3 12.1 3 8.8 3 6.1 5.1 4 7.8 4c1.5 0 3 .7 4 1.9C12.8 4.7 14.3 4 15.8 4 18.5 4 21 6.1 21 8.8c0 3.3-3 6-7.7 10.2zM8 12h2l1-2 2 4 1-2h2v1h-1.4l-1.7 3.4-2-4-1 2H8z"/></svg>',
  '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V4h2v14h14v2zM8 15l3-3 3 2 4-6 1.7 1-5.4 8-3.1-2-2.8 2.8z"/></svg>',
];
---

<section class="section-spaced">
  <div class="mx-auto max-w-6xl px-6">
    <h2
      class="feature-loop-heading text-center"
      style="
        font-size: var(--feature-loop-heading-size, var(--text-heading));
        font-weight: var(--weight-heading);
        line-height: var(--leading-heading);
        letter-spacing: var(--tracking-heading);
        color: var(--color-text-1);
        margin: 0 auto var(--space-xl);
      "
    >
      {t.featureGrid.heading}
    </h2>

    <ul class="feature-static" role="list">
      {featuresData.map((f) => (
        <li>
          <a href={f.href} class="feature-static-card">
            <span class="feature-static-title">{f.title}</span>
            <span class="feature-static-desc">{f.desc}</span>
          </a>
        </li>
      ))}
    </ul>

    <div
      class="feature-loop"
      id="feature-loop"
      data-active-index="0"
      data-animate
      aria-label={t.featureGrid.heading}
      role="group"
      tabindex="0"
    >
      <div class="feature-loop-rail" aria-hidden="true">
        <span class="feature-loop-track"></span>
        <span class="feature-loop-progress"></span>
        <span class="feature-loop-current"></span>
      </div>

      <ol class="feature-loop-steps" role="list">
        {featuresData.map((feature, index) => (
          <li class="feature-loop-step-item">
            <button
              type="button"
              class:list={['feature-loop-step', { 'is-active': index === 0 }]}
              data-index={index}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span class="feature-loop-step-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="feature-loop-step-icon" set:html={featureLoopIcons[index]} />
              <span class="feature-loop-step-label">{t.featureGrid.segmentLabels[index]}</span>
              <span class="sr-only">{feature.title}</span>
            </button>
          </li>
        ))}
      </ol>

      <a
        class="feature-loop-panel"
        id="feature-loop-panel"
        href={featuresData[0].href}
        aria-label={`${t.featureGrid.exploreCta} ${featuresData[0].title}`}
      >
        <span class="feature-loop-panel-icon" set:html={featureLoopIcons[0]} />
        <span class="feature-loop-panel-copy" aria-live="off">
          <span class="feature-loop-panel-title">{featuresData[0].title}</span>
          <span class="feature-loop-panel-desc">{featuresData[0].desc}</span>
        </span>
        <span class="feature-loop-panel-cta">{t.featureGrid.exploreCta} &#x2192;</span>
      </a>
    </div>
  </div>
</section>

<script is:inline define:vars={{ featuresData, exploreCta: t.featureGrid.exploreCta, iconMarkup: featureLoopIcons }}>
  window.__featureLoopData = { features: featuresData, exploreCta: exploreCta, iconMarkup: iconMarkup };
</script>

<script is:inline>
  (function() {
    var loop = document.getElementById('feature-loop');
    if (!loop) return;

    var data = window.__featureLoopData || {};
    var icons = data.iconMarkup || [];
    var features = (data.features || []).map(function(feature, index) {
      return {
        title: feature.title,
        desc: feature.desc,
        href: feature.href,
        iconMarkup: icons[index] || ''
      };
    });
    if (!features.length) return;

    var buttons = Array.prototype.slice.call(loop.querySelectorAll('.feature-loop-step'));
    var panel = document.getElementById('feature-loop-panel');
    var panelIcon = panel ? panel.querySelector('.feature-loop-panel-icon') : null;
    var panelCopy = panel ? panel.querySelector('.feature-loop-panel-copy') : null;
    var panelTitle = panel ? panel.querySelector('.feature-loop-panel-title') : null;
    var panelDesc = panel ? panel.querySelector('.feature-loop-panel-desc') : null;
    var exploreCta = data.exploreCta || 'Explore';
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var activeIndex = 0;
    var timer = null;
    var panelAnimationTimer = null;
    var isPaused = false;

    function normalizeIndex(index) {
      return ((index % features.length) + features.length) % features.length;
    }

    function clearTimer() {
      if (timer) {
        window.clearTimeout(timer);
        timer = null;
      }
    }

    function cuePanelAnimation() {
      if (!panel || reducedMotion) return;
      window.clearTimeout(panelAnimationTimer);
      panel.classList.remove('is-updating');
      void panel.offsetWidth;
      panel.classList.add('is-updating');
      panelAnimationTimer = window.setTimeout(function() {
        panel.classList.remove('is-updating');
      }, 240);
    }

    function scheduleNext() {
      clearTimer();
      if (reducedMotion || isPaused || features.length < 2) return;
      timer = window.setTimeout(function() {
        setActive(activeIndex + 1, { keepTimer: true, auto: true });
        scheduleNext();
      }, 3400);
    }

    function setPanelIcon(markup) {
      if (!panelIcon || !markup) return;
      panelIcon.innerHTML = markup;
    }

    function setActive(index, options) {
      activeIndex = normalizeIndex(index);
      var feature = features[activeIndex];
      loop.setAttribute('data-active-index', String(activeIndex));

      buttons.forEach(function(button, buttonIndex) {
        var isActive = buttonIndex === activeIndex;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      if (panel) {
        panel.href = feature.href;
        panel.setAttribute('aria-label', exploreCta + ' ' + feature.title);
      }
      if (panelCopy) {
        panelCopy.setAttribute('aria-live', options && (options.auto || options.silent) ? 'off' : 'polite');
      }
      if (panelTitle) panelTitle.textContent = feature.title;
      if (panelDesc) panelDesc.textContent = feature.desc;
      setPanelIcon(feature.iconMarkup);
      if (!options || !options.silent) cuePanelAnimation();

      if (!options || !options.keepTimer) {
        scheduleNext();
      }
    }

    buttons.forEach(function(button) {
      button.addEventListener('click', function() {
        setActive(parseInt(button.getAttribute('data-index'), 10));
      });
    });

    loop.addEventListener('keydown', function(event) {
      var nextKeys = ['ArrowRight', 'ArrowDown'];
      var previousKeys = ['ArrowLeft', 'ArrowUp'];
      if (nextKeys.indexOf(event.key) !== -1 || previousKeys.indexOf(event.key) !== -1) {
        event.preventDefault();
        setActive(activeIndex + (nextKeys.indexOf(event.key) !== -1 ? 1 : -1));
        if (buttons[activeIndex]) buttons[activeIndex].focus();
      }
    });

    function pauseLoop() {
      isPaused = true;
      clearTimer();
    }

    function resumeLoop() {
      isPaused = false;
      scheduleNext();
    }

    loop.addEventListener('pointerenter', pauseLoop);
    loop.addEventListener('pointerleave', resumeLoop);
    loop.addEventListener('focusin', pauseLoop);
    loop.addEventListener('focusout', function(event) {
      if (!loop.contains(event.relatedTarget)) {
        resumeLoop();
      }
    });

    setActive(0, { silent: true });
  })();
</script>
