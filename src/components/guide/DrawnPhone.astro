---
// A drawn phone screen for a step with no demo capture. It repeats the app's own words (traced in
// Localizable.xcstrings, 1.7.6) and marks the control to tap. It is a drawing, so screen readers
// skip it: the step text and the caption say the same thing.
interface Option {
  label: string;
  sub?: string;
  hot?: boolean;
}
interface Props {
  title: string;
  sub?: string;
  rows?: string[];
  options?: Option[];
  pill?: string;
  quiet?: string;
}
const { title, sub, rows = [], options = [], pill, quiet } = Astro.props;
---
<div class="dphone" aria-hidden="true">
  <p class="dphone-title">{title}</p>
  {sub && <p class="dphone-sub">{sub}</p>}
  {rows.map((row) => <p class="dphone-row">{row}</p>)}
  {options.map((option) => (
    <div class:list={['dphone-option', { hot: option.hot }]}>
      <span>{option.label}</span>
      {option.sub && <small>{option.sub}</small>}
    </div>
  ))}
  {pill && <span class="dphone-pill hot">{pill}</span>}
  {quiet && <span class="dphone-quiet">{quiet}</span>}
</div>

<style>
  .dphone {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 320px;
    padding: 24px 16px 16px;
    border: 1px solid var(--color-divider-strong);
    border-radius: 24px;
    background: var(--color-surface-el);
    font-size: 13px;
    line-height: 1.35;
    color: var(--color-text-1);
  }
  .dphone-title {
    font-size: 17px;
    font-weight: var(--weight-medium);
    line-height: 1.2;
  }
  .dphone-sub,
  .dphone-row {
    color: var(--color-text-2);
  }
  .dphone-row {
    padding: 8px 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .dphone-option {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 8px;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-sm);
    background: var(--color-surface-el-2);
  }
  .dphone-option small {
    font-size: 11px;
    color: var(--color-text-3);
  }
  .dphone-pill {
    margin-top: auto;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-text-1);
    color: var(--color-surface-el);
    text-align: center;
    font-weight: var(--weight-medium);
  }
  .dphone-quiet {
    text-align: center;
    color: var(--color-text-2);
  }
  .hot {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
