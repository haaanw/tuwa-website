---
// Product-vocabulary marquee band (demo-d). Track is aria-hidden; the
// sr-only paragraph carries the content for assistive tech.
// Copy comes from the per-locale home module (defaults to EN for index.astro).
// data-label-pause / data-label-play feed the toggle text in homeMotion.ts.
import { useHomeTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = useHomeTranslations(locale).marquee;
const track = [...t.terms, ...t.terms, ...t.terms, ...t.terms];
---
<section class="marquee" id="marquee" aria-label={t.sectionAria}>
  <p class="sr-only">{t.srText}</p>
  <div class="mq-track" aria-hidden="true">
    {track.map((term) => (
      <><span class="mq-item">{term}</span><span class="mq-tick"></span></>
    ))}
  </div>
  <button
    class="mq-pause"
    id="mqPause"
    aria-pressed="false"
    data-label-pause={t.pauseLabel}
    data-label-play={t.playLabel}
  >{t.pauseLabel}</button>
</section>
