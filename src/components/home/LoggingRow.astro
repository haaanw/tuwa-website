---
// 04 · Logging — restored as its own section (demo row 05), originally written
// for the 1.7.2 voice-logging release; updated 2026-09-24 for v1.7.4, which
// REMOVED workout voice logging (HAN ruling). Logging is typed description or
// direct entry now.
// Deliberately NOT a second fan: two fanned sections back to back read as one
// repeated trick. This is a flat three-up row on a surface band, each screen
// captioned in the annotation voice.
//
// The three plates trace ONE pipeline: type it → check the draft → it is in
// the record. The middle plate is the shipped set-entry surface, so the
// always-visible scrub scale with its TARGET and LAST markers is what the
// reader sees. The LLM is a parser, never a chat partner — no string here may
// frame it as a coach, an assistant, or a conversation (CONTEXT.md
// anti-positioning).
import { Image } from 'astro:assets';
import logCaptureShot from '../../assets/screens-v16/log-capture.png';
import activeWorkoutShot from '../../assets/screens-v16/active-workout.png';
import workoutLogShot from '../../assets/screens-v16/workout-log.png';
import { useHomeTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = useHomeTranslations(locale).logging;
const prefix = locale === 'en' ? '' : `/${locale}`;
const shots = [
  { src: logCaptureShot, alt: t.logCaptureAlt },
  { src: activeWorkoutShot, alt: t.activeWorkoutAlt },
  { src: workoutLogShot, alt: t.workoutLogAlt },
];
---
<section class="sec sec-logging sec-alt bt bb" id="logging">
  <div class="wrap">
    <span class="micro show-kicker">{t.kicker}</span>
    <h2 class="home-h2">{t.heading}</h2>
    <p class="sec-lede">{t.body}</p>

    <ul class="log-doors" data-anno-reveal>
      {t.doors.map((door) => <li class="micro">{door}</li>)}
    </ul>

    <p class="sec-lede log-manual">{t.manual}</p>

    <div class="logrow" data-anno-reveal>
      {shots.map((shot, i) => (
        <figure>
          <div class="plate"><Image src={shot.src} alt={shot.alt} width={640} format="webp" loading="lazy" decoding="async" /></div>
          <figcaption class="micro">{t.captions[i]}</figcaption>
        </figure>
      ))}
    </div>

    <p class="micro log-foot">{t.foot}</p>
    <p class="log-more"><a href={`${prefix}/features/text-logging`}>{t.moreLink}</a></p>
  </div>
</section>

<style>
  /* Scoped to this section so the homepage-only rules stay out of global.css,
     which ~18 feature pages and [...seoGeo] share. */
  .log-doors {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .log-doors li {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .log-doors li::before {
    content: '';
    width: 8px;
    height: 1px;
    background: var(--color-divider-strong);
  }
  .log-manual {
    margin-top: 24px;
  }
  .log-foot {
    display: block;
    margin-top: 32px;
  }
  .log-more {
    margin-top: 8px;
  }
  .log-more a {
    color: var(--color-text-1);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
</style>
