---
// 03 · The Day Card (W1; this was 04 · Logging). 1.7.6: "On Log, the whole program day sits on
// one card … Start, and the session runs right in the card. Drills with no weight log in one
// tap." Typed logging stays as the second door (text only — no microphone since v1.7.4); the
// LLM is a parser, never a chat partner. Two plates: the Day Card and the move plate.
import { Image } from 'astro:assets';
import { screensFor } from './screens';
import { useHomeTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = useHomeTranslations(locale).dayCard;
const shots = screensFor(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const plates = [
  { src: shots.dayCard, alt: t.dayCardAlt },
  { src: shots.plate, alt: t.plateAlt },
];
---
<section class="sec sec-logging sec-alt bt bb" id="day-card">
  <div class="wrap">
    <span class="micro show-kicker">{t.kicker}</span>
    <h2 class="home-h2">{t.heading}</h2>
    <p class="sec-lede">{t.body}</p>

    <ul class="log-doors" data-anno-reveal>
      {t.doors.map((door) => <li class="micro">{door}</li>)}
    </ul>

    <p class="sec-lede log-manual">{t.manual}</p>

    <div class="logrow logrow--two" data-anno-reveal>
      {plates.map((shot, i) => (
        <figure>
          <div class="plate"><Image src={shot.src} alt={shot.alt} width={640} format="webp" loading="lazy" decoding="async" /></div>
          <figcaption class="micro">{t.captions[i]}</figcaption>
        </figure>
      ))}
    </div>

    <p class="micro log-foot">{t.foot}</p>
    <p class="log-more"><a href={`${locale === 'zh' ? '/zh' : ''}/features/day-card/`}>{t.cardLink}</a></p>
    <p class="log-more"><a href={`${prefix}/features/text-logging`}>{t.moreLink}</a></p>
  </div>
</section>

<style>
  /* Scoped to this section so the homepage-only rules stay out of global.css,
     which ~18 feature pages and [...seoGeo] share. */
  .log-doors {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .log-doors li {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .log-doors li::before {
    content: '';
    width: 8px;
    height: 1px;
    background: var(--color-divider-strong);
  }
  .log-manual {
    margin-top: 24px;
  }
  .log-foot {
    display: block;
    margin-top: 32px;
  }
  .log-more {
    margin-top: 8px;
  }
  .log-more a {
    color: var(--color-text-1);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
</style>
