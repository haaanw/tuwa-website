---
// Section 04 · logging (demo-d): the fanned 3-plate spread (movement bank /
// active workout / workout log). The fan opens on scroll via --p; no-JS and
// reduced-motion render the fan fully open (--p: 1 default).
// Copy comes from the per-locale home module (defaults to EN for index.astro).
import { Image } from 'astro:assets';
import movementBankShot from '../../assets/screens-v16/movement-bank.png';
import activeWorkoutShot from '../../assets/screens-v16/active-workout.png';
import workoutLogShot from '../../assets/screens-v16/workout-log.png';
import { useHomeTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = useHomeTranslations(locale).logging;
---
<section class="sec sec-alt bt">
  <div class="ghost ghost-left num" data-ghost aria-hidden="true">04</div>
  <div class="wrap">
    <div class="sec-head" style="margin-left:auto">
      <span class="micro" data-reveal>{t.kicker}</span>
      <h2 data-reveal>{t.heading}</h2>
      <p data-reveal>{t.body}</p>
    </div>
    <div class="sec-body">
      <div class="spread spread-3" data-spread>
        <div class="plate" data-fan="l"><Image src={movementBankShot} alt={t.movementBankAlt} width={640} format="webp" loading="lazy" decoding="async" /></div>
        <div class="plate" data-fan="c"><Image src={activeWorkoutShot} alt={t.activeWorkoutAlt} width={640} format="webp" loading="lazy" decoding="async" /></div>
        <div class="plate" data-fan="r"><Image src={workoutLogShot} alt={t.workoutLogAlt} width={640} format="webp" loading="lazy" decoding="async" /></div>
      </div>
    </div>
  </div>
</section>
