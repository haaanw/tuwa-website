---
// 03 · The system — the fanned spread (demo row 04).
// The fan is the whole-product moment and nothing else: recovery, today's
// decision, and the set you are in the middle of. Logging has its own section
// (04) so this one no longer carries the movement-bank sentence.
//
// Frames are the site's light plates — three dark bezels fanned over stone
// read as three heavy slabs; three light frames read as one raised plane
// holding three screens. The spread opens on scroll via --p (set by
// homeMotion.ts); no-JS and reduced motion render it fully open.
import { Image } from 'astro:assets';
import recoveryShot from '../../assets/screens-v16/recovery.png';
import dashboardShot from '../../assets/screens-v16/dashboard.png';
import activeWorkoutShot from '../../assets/screens-v16/active-workout.png';
import { useHomeTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = useHomeTranslations(locale).system;
---
<section class="sec" id="system">
  <div class="wrap sys-head">
    <span class="micro show-kicker">{t.kicker}</span>
    <h2 class="home-h2">{t.heading}</h2>
    <p class="sys-body">{t.body}</p>
  </div>
  <div class="fan" data-spread>
    <div class="plate fan-l"><Image src={recoveryShot} alt={t.recoveryAlt} width={640} format="webp" loading="lazy" decoding="async" /></div>
    <div class="plate fan-c"><Image src={dashboardShot} alt={t.dashboardAlt} width={640} format="webp" loading="lazy" decoding="async" /></div>
    <div class="plate fan-r"><Image src={activeWorkoutShot} alt={t.activeWorkoutAlt} width={640} format="webp" loading="lazy" decoding="async" /></div>
  </div>
</section>
