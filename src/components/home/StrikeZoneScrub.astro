---
// Section 02 · training load (demo-d): pinned ACWR strike-zone bar scrub
// (0.40 → 1.45) with live zone-label rewrite and value chip, then the
// dashboard plate + needle-sweep Lottie well. Final values (1.45, needle at
// 80.8%, zone label 2) are baked in markup for no-JS/reduced-motion.
// Copy comes from the per-locale home module (defaults to EN for index.astro).
// data-zones carries the four live zone labels for homeMotion.ts.
import { Image } from 'astro:assets';
import dashboardShot from '../../assets/screens-v16/dashboard.png';
import { useHomeTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = useHomeTranslations(locale).zoneScrub;
const legendClasses = ['zleg-low', 'zleg-opt', 'zleg-caut', 'zleg-dang'];
---
<section class="sec sec-alt bt">
  <div class="ghost ghost-left num" data-ghost aria-hidden="true">02</div>
  <div class="wrap">
    <div class="sec-head" style="margin-left:auto">
      <span class="micro" data-reveal>{t.kicker}</span>
      <h2 data-reveal>{t.heading}</h2>
      <p data-reveal>{t.body}</p>
    </div>
  </div>
  <div class="zone-wrap" id="zoneWrap">
    <div class="zone-sticky">
      <div class="wrap">
        <div class="zone-head">
          <span class="micro">{t.barMicro}</span>
          <h3 class="zone-label zl2 num" id="zoneLabel" data-zones={JSON.stringify(t.zoneLabels)}>{t.zoneLabels[2]}</h3>
          <p class="zone-copy">{t.zoneCopy}</p>
        </div>
        <div class="zone-bar" id="zoneBar">
          <div class="zseg zseg-low"></div>
          <div class="zseg zseg-opt"></div>
          <div class="zseg zseg-caut"></div>
          <div class="zseg zseg-dang"></div>
          <div class="zone-fill" id="zoneFill" style="transform:scaleX(0.808)"></div>
          <div class="zone-needle" id="zoneNeedle" style="left:80.8%">
            <span class="zone-chip num" id="zoneChip">1.45</span>
          </div>
        </div>
        <div class="zone-legend" aria-hidden="true">
          {t.legend.map((item, i) => (
            <span class={legendClasses[i]}><span class="micro">{item}</span></span>
          ))}
        </div>
        <p class="zone-foot">{t.foot}</p>
      </div>
    </div>
  </div>
  <div class="wrap">
    <div class="sec-body">
      <div class="spread" data-spread>
        <div class="plate" data-fan="c"><Image src={dashboardShot} alt={t.dashboardAlt} width={640} format="webp" loading="lazy" decoding="async" /></div>
      </div>
      <div class="aside" data-reveal>
        <div class="lottie-plate"><div data-lottie="/lottie/needle-sweep.json" aria-label={t.lottieAria}></div></div>
        <span class="micro lottie-cap">{t.lottieCaption}</span>
        <p style="margin-top:16px">{t.aside}</p>
      </div>
    </div>
  </div>
</section>
