---
// Pavilion homepage hero (demo-d): pinned scrub 0→82 with tick-rail needle.
// Final values (82, needle at 82%) are baked in markup — no-JS and
// reduced-motion users see the finished state.
// Copy comes from the per-locale home module (defaults to EN for index.astro).
import { APP_STORE_URL } from '../../config';
import { useHomeTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = useHomeTranslations(locale).heroScrub;
---
<section class="hero-wrap" id="heroWrap" aria-label={t.sectionAria}>
  <div class="hero-sticky">
    <div class="wrap hero-grid">
      <div class="hero-score" aria-label={t.scoreAria}>
        <span class="hero-score-n num" id="heroScore">82</span>
        <span class="micro">{t.scoreCaption}</span>
        <div class="score-rail" id="heroRail" aria-hidden="true">
          <span class="rail-needle" id="heroNeedle" style="left:82%"></span>
        </div>
        <div class="rail-ends" aria-hidden="true">
          <span class="micro num">0</span>
          <span class="micro num">100</span>
        </div>
      </div>
      <h1 class="hero-h1 lines" id="heroLines">
        {t.lines.map((line) => (
          <span class="line-mask"><span>{line}</span></span>
        ))}
      </h1>
      <div class="hero-copy">
        <p class="lead" data-reveal>{t.lead}</p>
        <p class="sub" data-reveal>{t.sub}</p>
        <div class="hero-cta" id="heroCtaRow">
          <a class="pill-ink" id="heroCta" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">{t.cta}</a>
          <span class="micro">{t.ctaNote}</span>
        </div>
      </div>
    </div>
    <div class="scroll-cue" id="scrollCue"><span class="micro">{t.scrollCue}</span></div>
  </div>
</section>
