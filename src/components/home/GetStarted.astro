---
// The clear start path (HAN, 2026-11-04): install, plan, add Tuwa to your AI. Sits right under the
// hero and has no number, so the numbered sections keep their order. Text links only: the hero's
// App Store badge stays the page's main action. The guide exists in en + zh; fr goes to en.
import { useHomeTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = useHomeTranslations(locale).getStarted;
const guide = locale === 'zh' ? '/zh/guide/' : '/guide/';
---
<section class="sec bt" id="get-started">
  <div class="wrap">
    <div data-reveal data-anno-reveal>
      <span class="micro show-kicker">{t.kicker}</span>
      <h2 class="home-h2">{t.heading}</h2>
    </div>
    <ol class="gs-steps" data-reveal>
      {t.steps.map((step) => (
        <li class="gs-step">
          <span class="micro num">{step.n}</span>
          <h3 class="gs-title">{step.title}</h3>
          <p class="gs-body">{step.body}</p>
          <p class="gs-links">
            {step.links.map((link) => <a href={`${guide}${link.path}`}>{link.label}</a>)}
          </p>
        </li>
      ))}
    </ol>
    <p class="gs-all"><a href={guide}>{t.allLink}</a></p>
  </div>
</section>

<style>
  .gs-steps {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .gs-step {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    background: var(--color-surface-el);
  }
  .gs-step + .gs-step {
    border-left: 1px solid var(--color-divider);
  }
  .gs-title {
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
  }
  .gs-body {
    color: var(--color-text-2);
    font-size: var(--text-small);
  }
  .gs-links {
    font-size: var(--text-small);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: auto;
    padding-top: 8px;
  }
  .gs-links a,
  .gs-all a {
    color: var(--color-text-1);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .gs-all {
    margin-top: 16px;
  }
  @media (max-width: 760px) {
    .gs-steps {
      grid-template-columns: minmax(0, 1fr);
    }
    .gs-step + .gs-step {
      border-left: none;
      border-top: 1px solid var(--color-divider);
    }
  }
</style>
