---
// Section 05 · privacy + closing CTA (demo-d): debossed privacy well and the
// closing ink pill. The nav pill hides while this CTA is on screen
// (nav CTA discipline in homeMotion.ts).
// Copy comes from the per-locale home module (defaults to EN for index.astro).
import { APP_STORE_URL } from '../../config';
import { useHomeTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = useHomeTranslations(locale).privacyClose;
---
<section class="sec bt" id="get">
  <div class="ghost num" data-ghost aria-hidden="true">05</div>
  <div class="wrap">
    <div class="sec-head">
      <span class="micro" data-reveal>{t.kicker}</span>
      <h2 data-reveal>{t.heading}</h2>
      <p data-reveal>{t.body}</p>
    </div>
    <div class="privacy-well" data-reveal>
      <ul>
        {t.bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    </div>
    <div class="closing-cta" data-reveal>
      <a class="pill-ink" id="closeCta" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">{t.cta}</a>
      <span class="micro">{t.ctaNote}</span>
    </div>
  </div>
</section>
