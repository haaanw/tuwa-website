---
// Demo-d one-line footer, extended with the site's page links and the
// language switcher in quiet micro type (the minimal header carries no nav,
// so the footer is the canonical navigation surface).
import { getRelativeLocaleUrl } from 'astro:i18n';
import { APP_STORE_URL } from '../config';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const year = new Date().getFullYear();
const t = useTranslations(locale as 'en' | 'zh' | 'fr');

// Path-preserving locale switch (moved here from the old header nav)
const rawPath = Astro.url.pathname;
const knownLocales = ['en', 'zh', 'fr'];
const pathSegments = rawPath.split('/');
const pathWithoutLocale = knownLocales.includes(pathSegments[1])
  ? '/' + pathSegments.slice(2).join('/')
  : rawPath;

const LOCALES = [
  { code: 'en', label: t.nav.languageSwitcher.en },
  { code: 'zh', label: t.nav.languageSwitcher.zh },
  { code: 'fr', label: t.nav.languageSwitcher.fr },
] as const;

const ENGLISH_ONLY_PATH_PREFIXES = [
  '/strength-readiness-calculator',
  '/weekly-training-review-template',
  '/apple-watch-training-load-for-lifters',
  '/guides/',
  '/comparisons/',
];
const isEnglishOnlyPath = ENGLISH_ONLY_PATH_PREFIXES.some((prefix) =>
  rawPath === prefix || rawPath.startsWith(prefix)
);
const availableLocales = isEnglishOnlyPath ? LOCALES.filter(({ code }) => code === 'en') : LOCALES;
const showLanguageSwitcher = availableLocales.length > 1;

---
<footer class="site-footer">
  <div class="wrap micro">
    <nav class="f-row" aria-label="Footer navigation">
      <a href={getRelativeLocaleUrl(locale, '/features/verdict')}>{t.drawer.verdict}</a>
      <a href={getRelativeLocaleUrl(locale, '/features/smart-templates')}>{t.nav.featuresDropdown.smartTemplatesTitle}</a>
      <a href={getRelativeLocaleUrl(locale, '/features/workload-tracking')}>{t.nav.featuresDropdown.workloadTrackingTitle}</a>
      <a href={getRelativeLocaleUrl(locale, '/features/recovery-scoring')}>{t.nav.featuresDropdown.recoveryScoringTitle}</a>
      <a href={getRelativeLocaleUrl(locale, '/features/cold-start')}>{t.nav.featuresDropdown.coldStartTitle}</a>
      <a href={getRelativeLocaleUrl(locale, '/methodology')}>{t.footer.methodology}</a>
      <a href={getRelativeLocaleUrl(locale, '/readiness-score')}>{t.footer.readinessScore}</a>
      <a href={getRelativeLocaleUrl(locale, '/training-load')}>{t.footer.trainingLoad}</a>
      <a href={getRelativeLocaleUrl(locale, '/compare')}>{t.footer.compare}</a>
      {locale === 'en' && (
        <>
          <a href="/strength-readiness-calculator">Readiness calculator</a>
          <a href="/apple-watch-training-load-for-lifters">Apple Watch for lifters</a>
          <a href="/guides/hrv-for-strength-training">HRV for strength</a>
        </>
      )}
      <a href={getRelativeLocaleUrl(locale, '/about')}>{t.drawer.about}</a>
      <a href={getRelativeLocaleUrl(locale, '/blog')}>{t.nav.blog}</a>
      <a href={getRelativeLocaleUrl(locale, '/support')}>{t.nav.support}</a>
      <a href={getRelativeLocaleUrl(locale, '/privacy')}>{t.footer.privacy}</a>
      <a href={getRelativeLocaleUrl(locale, '/terms')}>{t.footer.terms}</a>
      <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">{t.nav.getApp}</a>
    </nav>
    {showLanguageSwitcher && (
      <nav class="f-row" aria-label={t.nav.languageSwitcher.label}>
        {availableLocales.map(({ code, label }) => (
          <a
            href={getRelativeLocaleUrl(code, pathWithoutLocale)}
            aria-current={code === locale ? 'true' : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
    )}
    <div class="f-row">
      <span>{t.footer.copyright.replace('{year}', String(year))}</span>
      <span class="f-tick" aria-hidden="true"></span>
      <span>iOS 17+</span>
    </div>
  </div>
</footer>
