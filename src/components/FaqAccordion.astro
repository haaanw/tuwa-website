---
// FAQ accordion — Pavilion style: hairline-ruled details/summary list.
// Q&A content lives in the per-locale support module; FAQPage JSON-LD is
// emitted here so every locale's support page carries the schema.
// Content is fully visible without JS (native <details>); siteMotion.ts
// adds the open-answer fade via initFaqMotion.
import { useSupportTranslations } from '../i18n/utils';
import { faqPageSchema } from '../seo/schema';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const t = useSupportTranslations(locale as any);
const faqs = t.faq;
const faqSchema = faqPageSchema(faqs);
---
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-heading {
    font-size: var(--text-heading);
    font-weight: var(--weight-heading);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text-1);
  }
  .faq-list {
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--color-divider);
  }
  .faq-item {
    border-bottom: 1px solid var(--color-divider);
  }
  .faq-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 44px;
    padding: var(--space-md) 0;
    font-size: var(--text-body);
    font-weight: var(--weight-label);
    color: var(--color-text-1);
    cursor: pointer;
  }
  .faq-summary::marker,
  .faq-summary::-webkit-details-marker {
    display: none;
  }
  .faq-summary::after {
    content: '+';
    flex: none;
    font-size: 20px;
    font-weight: var(--weight-body);
    color: var(--color-text-3);
  }
  .faq-item[open] > .faq-summary::after {
    content: '\2212';
  }
  .faq-answer {
    margin: 0;
    max-width: 680px;
    padding-bottom: var(--space-md);
    color: var(--color-text-2);
    line-height: var(--leading-body);
    font-weight: var(--weight-body);
  }
  @media (prefers-reduced-motion: no-preference) {
    .faq-summary::after {
      transition: transform 150ms var(--ease-interactive), color 150ms var(--ease-interactive);
    }
    .faq-summary:hover::after {
      color: var(--color-accent);
      transform: scale(1.08);
    }
  }
</style>

<h2 class="faq-heading" data-animate>{t.faqHeading}</h2>
<div class="faq-list" data-animate>
  {faqs.map(({ q, a }) => (
    <details class="faq-item">
      <summary class="faq-summary">{q}</summary>
      <p class="faq-answer">{a}</p>
    </details>
  ))}
</div>
