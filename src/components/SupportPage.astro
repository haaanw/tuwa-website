---
// Support page body — Pavilion system. Shared across en / zh / fr; all copy
// comes from the per-locale support module. Reveals use the site-wide
// [data-animate] system (siteMotion.ts via BaseLayout); everything renders
// fully visible without JS.
import { SUPPORT_EMAIL } from '../config';
import { useSupportTranslations, type Locale } from '../i18n/utils';
import FaqAccordion from './FaqAccordion.astro';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = useSupportTranslations(locale);
---
<style>
  /* Page-local composition only — tokens and shared classes come from global.css. */
  .support-hero {
    padding-top: clamp(144px, 16vw, 200px);
    padding-bottom: clamp(64px, 8vw, 96px);
  }
  .support-h1 {
    margin-top: var(--space-lg);
    font-size: var(--text-display);
    line-height: 1.02;
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-1);
  }
  .support-lede {
    margin-top: var(--space-xl);
    max-width: 560px;
    font-size: var(--text-lede);
    line-height: var(--leading-body);
    color: var(--color-text-2);
  }

  /* Debossed contact well — relief, not shadow (Pavilion well gradient). */
  .contact-well {
    margin-top: var(--space-2xl);
    max-width: 640px;
    padding: var(--space-xl);
    background: linear-gradient(180deg, var(--color-well-top), var(--color-well-bottom));
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    box-shadow: inset 0 1px 0 rgba(0, 0, 0, 0.03);
  }
  .contact-well .micro {
    display: block;
  }
  .contact-email {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: var(--text-subheading);
    font-weight: var(--weight-label);
    line-height: var(--leading-subheading);
    color: var(--color-text-1);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    word-break: break-all;
  }
  .contact-note {
    margin-top: var(--space-md);
    font-size: var(--text-label);
    line-height: var(--leading-label);
    color: var(--color-text-3);
  }

  /* App-requirements micro-block */
  .req-row {
    margin-top: var(--space-2xl);
    max-width: 640px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-divider);
  }
  .req-value {
    font-size: var(--text-label);
    font-weight: var(--weight-label);
    color: var(--color-text-1);
    white-space: nowrap;
  }
</style>

<section class="sec support-hero" aria-label={t.meta.title}>
  <div class="wrap">
    <span class="micro" data-animate>{t.hero.kicker}</span>
    <h1 class="support-h1" data-animate>{t.meta.title}</h1>
    <p class="support-lede" data-animate data-animate-delay="80">{t.hero.promise}</p>
  </div>
</section>

<section class="sec bt">
  <div class="wrap">
    <FaqAccordion locale={locale} />
  </div>
</section>

<section class="sec bt sec-alt">
  <div class="wrap">
    <div class="sec-head">
      <h2 data-animate>{t.contact.heading}</h2>
      <p data-animate>{t.contact.subtext}</p>
    </div>
    <div class="contact-well" data-animate>
      <span class="micro">{t.contact.emailLabel}</span>
      <a class="contact-email" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
      <p class="contact-note">{t.contact.responseTime}</p>
    </div>
    <div class="req-row" data-animate>
      <span class="micro">{t.requirements.label}</span>
      <span class="req-value num">{t.requirements.value}</span>
    </div>
  </div>
</section>
