---
// A plain, copyable text block for the hosted skill pages. The text sits in a <pre> so a model
// that fetches the page reads it as written, and a person can select it without JavaScript.
// The Copy button (shown only with JavaScript) copies the exact source string.
interface Props {
  text: string;
  label: string;
  copy: string;
  copied: string;
  copyFailed: string;
  rawHref?: string;
  rawLabel?: string;
}

const { text, label, copy, copied, copyFailed, rawHref, rawLabel } = Astro.props;
---
<figure class="copy-block" data-copy-block>
  <figcaption class="copy-block-bar">
    <span class="micro">{label}</span>
    <span class="copy-block-actions">
      {rawHref && rawLabel && <a class="copy-block-link" href={rawHref}>{rawLabel}</a>}
      <button
        type="button"
        class="copy-block-button"
        data-copy-button
        data-label-copy={copy}
        data-label-copied={copied}
        data-label-failed={copyFailed}
      >{copy}</button>
    </span>
  </figcaption>
  <pre class="copy-block-text" data-copy-source>{text}</pre>
</figure>

<script>
  function setLabel(button: HTMLButtonElement, key: 'labelCopy' | 'labelCopied' | 'labelFailed') {
    button.textContent = button.dataset[key] ?? '';
  }

  // In-app browsers often refuse the Clipboard API; the old copy command still works there.
  function copyWithCommand(text: string): boolean {
    const area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.position = 'fixed';
    area.style.opacity = '0';
    document.body.appendChild(area);
    area.select();
    let copied = false;
    try {
      copied = document.execCommand('copy');
    } catch {
      copied = false;
    }
    area.remove();
    return copied;
  }

  // Last resort: select the block so the athlete can copy it by hand.
  function selectSource(source: HTMLElement) {
    const range = document.createRange();
    range.selectNodeContents(source);
    const selection = window.getSelection();
    selection?.removeAllRanges();
    selection?.addRange(range);
  }

  document.querySelectorAll<HTMLElement>('[data-copy-block]').forEach((block) => {
    const button = block.querySelector<HTMLButtonElement>('[data-copy-button]');
    const source = block.querySelector<HTMLElement>('[data-copy-source]');
    if (!button || !source) return;
    let reset: number | undefined;
    button.addEventListener('click', async () => {
      window.clearTimeout(reset);
      const text = source.textContent ?? '';
      let copied = false;
      try {
        await navigator.clipboard.writeText(text);
        copied = true;
      } catch {
        copied = copyWithCommand(text);
      }
      if (copied) {
        setLabel(button, 'labelCopied');
      } else {
        selectSource(source);
        setLabel(button, 'labelFailed');
      }
      reset = window.setTimeout(() => setLabel(button, 'labelCopy'), 2000);
    });
  });
</script>

<style>
  .copy-block {
    margin: 0;
    background: var(--color-surface-el);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .copy-block-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--color-divider);
  }
  .copy-block-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }
  .copy-block-link {
    font-size: var(--text-small);
    color: var(--color-text-2);
    text-decoration: underline;
  }
  .copy-block-button {
    min-height: 32px;
    padding: 0 var(--space-md);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--color-text-1);
    background: var(--color-surface-el-2);
    border: 1px solid var(--color-divider-strong);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
  .copy-block-button:hover {
    background: var(--color-surface);
  }
  .copy-block-button:focus-visible,
  .copy-block-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  :global(html:not(.js-enabled)) .copy-block-button {
    display: none;
  }
  /* Wrap long lines inside the block: no sideways scroll at phone width. The copied text keeps
     its own line breaks. */
  .copy-block-text {
    margin: 0;
    padding: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--anno);
    line-height: var(--leading-anno);
    color: var(--color-text-1);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    tab-size: 2;
  }
</style>
